<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Student Login | Skill Record</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .password-container {
      position: relative;
    }
    .toggle-password {
      position: absolute;
      right: 16px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      color: var(--text-muted);
      transition: var(--transition);
    }
    .toggle-password:hover {
      color: white;
    }
  </style>
</head>
<body class="auth-page">

  <div class="auth-card">
    <form action="/student/login" method="POST">
      <h2>Student Login</h2>
      <h3>Enter your credentials to access your dashboard</h3>

      <div class="form-group">
        <label for="roll">Roll Number</label>
        <input type="text" id="roll" name="rollno" class="form-control" placeholder="Enter your roll number" required>
      </div>

      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="name@college.edu" required>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <div class="password-container">
          <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
          <i class="fa-solid fa-eye toggle-password" onclick="togglePassword('password', this)"></i>
        </div>
      </div>

      <button type="submit" class="auth-btn">Sign In</button>
      
      <div class="auth-footer">
        Don't have an account? <a href="/student/signup">Create one</a>
      </div>
      
      <a href="/" class="back-link">← Back to Home</a>
    </form>

    <% if(message && message.length > 0){ %>
      <script>
        document.addEventListener("DOMContentLoaded", function() {
            const msg = "<%= message %>";
            const isError = msg.toLowerCase().includes('error') || msg.toLowerCase().includes('invalid');
            Toastify({
                text: msg,
                duration: 4000,
                gravity: "top",
                position: "right",
                style: {
                    background: isError ? "#ef4444" : "#10b981",
                    borderRadius: "8px",
                    boxShadow: "0 4px 12px rgba(0,0,0,0.15)"
                }
            }).showToast();
        });
      </script>
    <% } %>
  </div>

  <script>
    function togglePassword(inputId, icon) {
      const input = document.getElementById(inputId);
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }
  </script>

  <!-- Global Loader -->
  <div id="global-loader" class="loader-overlay">
    <div class="spinner"></div>
    <div class="loader-text">Processing...</div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const forms = document.querySelectorAll("form");
      const loader = document.getElementById("global-loader");
      
      forms.forEach(form => {
        form.addEventListener("submit", function() {
          if (form.checkValidity()) {
            loader.classList.add("active");
            const buttons = form.querySelectorAll("button[type='submit']");
            buttons.forEach(btn => btn.style.pointerEvents = 'none');
          }
        });
      });
    });
  </script>

</body>
</html>
