                      <a id="currentTaskFileLink" href="#" target="_blank" style="color: var(--accent); text-decoration: none;">View Existing File</a>
                  </div>
              </div>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
