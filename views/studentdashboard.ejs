              </div>
              <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px;">
                  <button type="button" onclick="closeTaskModal()" style="padding: 10px 20px; background: transparent; color: var(--text-muted); border: none; cursor: pointer; font-size: 0.9rem;">Cancel</button>
                  <button type="submit" id="taskModalBtn" style="padding: 10px 20px; background: linear-gradient(135deg, var(--primary), var(--accent)); color: #ffffff; border: none; border-radius: 8px; cursor: pointer; font-size: 0.9rem; font-weight: 600;">Submit Task</button>
              </div>
          </form>
      </div>
  </div>

  <!-- Delete Task Confirmation Modal -->
  <div id="deleteTaskModal" class="loader-overlay" style="z-index: 10000; align-items: center; justify-content: center;">
      <div style="background: var(--card-bg); padding: 32px; border-radius: 16px; border: 1px solid var(--glass-border); width: 90%; max-width: 400px; backdrop-filter: blur(20px); text-align: center;">
          <h3 style="margin-bottom: 16px; color: var(--text-main);">Confirm Deletion</h3>
          <p style="color: var(--text-muted); margin-bottom: 24px;">Are you sure you want to delete this daily task log? This action cannot be undone.</p>
          <div style="display: flex; gap: 12px; justify-content: center;">
              <button type="button" onclick="closeDeleteTaskModal()" style="padding: 10px 20px; background: transparent; color: var(--text-muted); border: 1px solid var(--glass-border); border-radius: 8px; cursor: pointer; font-size: 0.9rem;">Cancel</button>
              <form id="confirmDeleteTaskForm" method="POST" style="margin: 0;">
                  <button type="submit" style="padding: 10px 20px; background: #ef4444; color: #ffffff; border: none; border-radius: 8px; cursor: pointer; font-size: 0.9rem; font-weight: 600;">Delete</button>
              </form>
          </div>
      </div>
  </div>

  <!-- Submit Weekly Summary Modal -->
  <div id="summaryModal" class="loader-overlay" style="z-index: 10000; align-items: center; justify-content: center;">
      <div class="no-scrollbar" style="background: var(--card-bg); padding: 32px; border-radius: 16px; border: 1px solid var(--glass-border); width: 90%; max-width: 750px; backdrop-filter: blur(20px); max-height: 90vh; overflow-y: auto;">
          <h3 style="margin-bottom: 24px;">Submit Weekly Summary</h3>
          <form id="summaryForm" action="/student/submit-summary" method="POST" enctype="multipart/form-data">
              <div class="form-group">
                  <label>Week Number *</label>
                  <input type="number" id="summaryWeek" name="week" class="form-control" required placeholder="e.g. 1" oninput="onSummaryWeekChange()">
              </div>
              <div id="prevWeekGoalContainer" style="display: none; margin-bottom: 16px; padding: 12px; background: rgba(99, 102, 241, 0.05); border: 1px solid rgba(99, 102, 241, 0.15); border-radius: 8px;">
                  <label style="font-size: 0.85rem; color: var(--primary); font-weight: 600; display: block; margin-bottom: 4px;">Previous Week's Goals Reference:</label>
                  <div id="prevWeekGoalText" style="font-size: 0.85rem; line-height: 1.4; color: var(--text-main);"></div>
              </div>
              <div class="form-group">
                  <label>Work Completed This Week *</label>
                  <textarea name="workCompleted" class="form-control" rows="3" style="resize: none;" required placeholder="Summary of what you completed..."></textarea>
              </div>
              <div class="form-group">
                  <label>Challenges Faced *</label>
                  <textarea name="challengesFaced" class="form-control" rows="2" style="resize: none;" required placeholder="What challenges did you face?"></textarea>
              </div>
              <div class="form-group">
                  <label>How Challenges Were Solved *</label>
                  <textarea name="challengesSolved" class="form-control" rows="2" style="resize: none;" required placeholder="How did you overcome them?"></textarea>
              </div>
              <div class="form-group">
                  <label>Skills Learned *</label>
                  <input type="text" name="skillsLearned" class="form-control" required placeholder="e.g. Express, React, APIs (comma separated)">
              </div>
              <div class="form-group">
                  <label>Goals for Next Week *</label>
                  <textarea name="goalsNextWeek" class="form-control" rows="2" style="resize: none;" required placeholder="What are your target goals?"></textarea>
              </div>
              <div class="form-group">
                  <label>Summary File (Optional PDF/Image)</label>
                  <input type="file" name="summaryFile" class="form-control">
              </div>
              <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px;">
                  <button type="button" onclick="closeSummaryModal()" style="padding: 10px 20px; background: transparent; color: var(--text-muted); border: none; cursor: pointer; font-size: 0.9rem;">Cancel</button>
                  <button type="submit" style="padding: 10px 20px; background: linear-gradient(135deg, var(--primary), var(--accent)); color: #ffffff; border: none; border-radius: 8px; cursor: pointer; font-size: 0.9rem; font-weight: 600;">Submit Summary</button>
              </div>
          </form>
      </div>
  </div>

  <!-- Edit Weekly Summary Modal -->
  <div id="editSummaryModal" class="loader-overlay" style="z-index: 10000; align-items: center; justify-content: center;">
      <div class="no-scrollbar" style="background: var(--card-bg); padding: 32px; border-radius: 16px; border: 1px solid var(--glass-border); width: 90%; max-width: 750px; backdrop-filter: blur(20px); max-height: 90vh; overflow-y: auto;">
          <h3 style="margin-bottom: 24px;">Edit Weekly Summary</h3>
          <form id="editSummaryForm" action="" method="POST" enctype="multipart/form-data">
              <div class="form-group">
                  <label>Week Number</label>
                  <input type="number" id="editSummaryWeek" class="form-control" disabled>
              </div>
              <div class="form-group">
                  <label>Work Completed This Week *</label>
                  <textarea id="editSummaryCompleted" name="workCompleted" class="form-control" rows="3" style="resize: none;" required></textarea>
              </div>
              <div class="form-group">
                  <label>Challenges Faced *</label>
                  <textarea id="editSummaryChallenges" name="challengesFaced" class="form-control" rows="2" style="resize: none;" required></textarea>
              </div>
              <div class="form-group">
                  <label>How Challenges Were Solved *</label>
                  <textarea id="editSummarySolved" name="challengesSolved" class="form-control" rows="2" style="resize: none;" required></textarea>
              </div>
              <div class="form-group">
                  <label>Skills Learned *</label>
                  <input type="text" id="editSummarySkills" name="skillsLearned" class="form-control" required>
              </div>
              <div class="form-group">
                  <label>Goals for Next Week *</label>
                  <textarea id="editSummaryGoals" name="goalsNextWeek" class="form-control" rows="2" style="resize: none;" required></textarea>
              </div>
              <div class="form-group">
                  <label>Summary File (Optional PDF/Image)</label>
                  <input type="file" name="summaryFile" class="form-control">
                  <div id="currentSummaryFileContainer" style="margin-top: 8px; font-size: 0.85rem; display: none;">
                      <a id="currentSummaryFileLink" href="#" target="_blank" style="color: var(--accent); text-decoration: none;">View Existing File</a>
                  </div>
              </div>
              <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px;">
                  <button type="button" onclick="closeEditSummaryModal()" style="padding: 10px 20px; background: transparent; color: var(--text-muted); border: none; cursor: pointer; font-size: 0.9rem;">Cancel</button>
                  <button type="submit" style="padding: 10px 20px; background: linear-gradient(135deg, var(--primary), var(--accent)); color: #ffffff; border: none; border-radius: 8px; cursor: pointer; font-size: 0.9rem; font-weight: 600;">Save Changes</button>
              </div>
          </form>
      </div>
  </div>

  <script>
    const goalsByWeek = {
        <% weeklySummaries.forEach(s => { %>
            '<%= s.week %>': `<%= s.goalsNextWeek ? s.goalsNextWeek.replace(/`/g, '\\`').replace(/\n/g, '\\n').replace(/\r/g, '') : '' %>`,
        <% }) %>
    };

    function onSummaryWeekChange() {
        const weekVal = parseInt(document.getElementById('summaryWeek').value);
        if (weekVal > 1) {
            const prevWeekGoal = goalsByWeek[weekVal - 1];
            if (prevWeekGoal) {
                document.getElementById('prevWeekGoalContainer').style.display = 'block';
                document.getElementById('prevWeekGoalText').innerText = prevWeekGoal;
            } else {
                document.getElementById('prevWeekGoalContainer').style.display = 'block';
                document.getElementById('prevWeekGoalText').innerText = "No summary found for Week " + (weekVal - 1) + ".";
            }
        } else {
            document.getElementById('prevWeekGoalContainer').style.display = 'none';
        }
    }

    function openTaskModal(btn) {
        if (!btn) {
            document.getElementById('taskModalTitle').innerText = 'Submit Daily Task Log';
            document.getElementById('taskForm').action = '/student/submit-task';
            document.getElementById('taskFile').required = false;
            document.getElementById('taskModalBtn').innerText = 'Submit Task';
            
            document.getElementById('taskWeek').value = '';
            document.getElementById('taskTitle').value = '';
            document.getElementById('taskDate').value = new Date().toISOString().split('T')[0];
            document.getElementById('taskDesc').value = '';
            document.getElementById('taskHours').value = '';
            document.getElementById('taskStatus').value = 'Completed';
            document.getElementById('taskGit').value = '';
            document.getElementById('taskDemo').value = '';
            document.getElementById('currentTaskFileContainer').style.display = 'none';
        } else {
            document.getElementById('taskModalTitle').innerText = 'Edit Daily Task Log';
            const id = btn.getAttribute('data-id');
            document.getElementById('taskForm').action = '/student/edit-task/' + id;
            document.getElementById('taskFile').required = false;
            document.getElementById('taskModalBtn').innerText = 'Save Changes';
            
            document.getElementById('taskWeek').value = btn.getAttribute('data-week');
            document.getElementById('taskTitle').value = btn.getAttribute('data-title');
            document.getElementById('taskDate').value = btn.getAttribute('data-date');
            document.getElementById('taskDesc').value = btn.getAttribute('data-desc');
            document.getElementById('taskHours').value = btn.getAttribute('data-hours');
            document.getElementById('taskStatus').value = btn.getAttribute('data-status');
            document.getElementById('taskGit').value = btn.getAttribute('data-git');
            document.getElementById('taskDemo').value = btn.getAttribute('data-demo');
            
            const fileUrl = btn.getAttribute('data-file');
            if (fileUrl) {
                document.getElementById('currentTaskFileContainer').style.display = 'block';
                document.getElementById('currentTaskFileLink').href = fileUrl;
            } else {
                document.getElementById('currentTaskFileContainer').style.display = 'none';
            }
        }
        document.getElementById('taskModal').classList.add('active');
    }

    function closeTaskModal() {
        document.getElementById('taskModal').classList.remove('active');
    }

    function openDeleteTaskModal(id) {
        document.getElementById('confirmDeleteTaskForm').action = '/student/delete-task/' + id;
        document.getElementById('deleteTaskModal').classList.add('active');
    }

    function closeDeleteTaskModal() {
        document.getElementById('deleteTaskModal').classList.remove('active');
    }

    function openSummaryModal() {
        document.getElementById('summaryWeek').value = '';
        document.getElementById('summaryForm').reset();
        document.getElementById('prevWeekGoalContainer').style.display = 'none';
        document.getElementById('summaryModal').classList.add('active');
    }

    function closeSummaryModal() {
        document.getElementById('summaryModal').classList.remove('active');
    }

    function openEditSummaryModal(btn) {
        const id = btn.getAttribute('data-id');
        document.getElementById('editSummaryForm').action = '/student/edit-summary/' + id;
        
        document.getElementById('editSummaryWeek').value = btn.getAttribute('data-week');
        document.getElementById('editSummaryCompleted').value = btn.getAttribute('data-completed');
        document.getElementById('editSummaryChallenges').value = btn.getAttribute('data-challenges');
        document.getElementById('editSummarySolved').value = btn.getAttribute('data-solutions');
        document.getElementById('editSummarySkills').value = btn.getAttribute('data-skills');
        document.getElementById('editSummaryGoals').value = btn.getAttribute('data-goals');
        
        const fileUrl = btn.getAttribute('data-file');
        if (fileUrl) {
            document.getElementById('currentSummaryFileContainer').style.display = 'block';
            document.getElementById('currentSummaryFileLink').href = fileUrl;
        } else {
            document.getElementById('currentSummaryFileContainer').style.display = 'none';
        }
        
        document.getElementById('editSummaryModal').classList.add('active');
    }

    function closeEditSummaryModal() {
        document.getElementById('editSummaryModal').classList.remove('active');
    }
  </script>

    <!-- Account Delete Modal -->
  <div id="accountDeleteModal" class="loader-overlay" style="z-index: 10000; align-items: center; justify-content: center;">
      <div style="background: var(--card-bg); padding: 32px; border-radius: 16px; border: 1px solid var(--glass-border); width: 90%; max-width: 400px; backdrop-filter: blur(20px); text-align: center;">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" style="margin-bottom: 16px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          <h3 style="margin-bottom: 12px; color: #ef4444;">Delete Account</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 24px;">This action is permanent and cannot be undone. All your logs and data will be erased. To confirm, type your Roll Number below:</p>
          <form id="accountDeleteForm" action="/student/deleteaccount" method="POST" style="margin: 0;">
              <input type="text" id="confirmRollNo" class="form-control" placeholder="Enter Roll Number" style="margin-bottom: 24px; text-align: center;" oninput="document.getElementById('finalDeleteBtn').disabled = (this.value !== '<%= student.rollno %>')">
              <div style="display: flex; gap: 12px; justify-content: center;">
                  <button type="button" onclick="closeAccountDeleteModal()" style="padding: 10px 20px; background: transparent; color: var(--text-muted); border: 1px solid var(--glass-border); border-radius: 8px; cursor: pointer; font-size: 0.9rem; flex: 1;">Cancel</button>
                  <button type="submit" id="finalDeleteBtn" disabled style="padding: 10px 20px; background: #ef4444; color: #ffffff; border: none; border-radius: 8px; cursor: pointer; font-size: 0.9rem; font-weight: 600; flex: 1;">Delete Forever</button>
              </div>
          </form>
      </div>
  </div>

  <!-- Change Password Modal -->
  <div id="changePasswordModal" class="loader-overlay" style="z-index: 10000; align-items: center; justify-content: center;">
      <div style="background: var(--card-bg); padding: 32px; border-radius: 16px; border: 1px solid var(--glass-border); width: 90%; max-width: 500px; backdrop-filter: blur(20px);">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              <h3 style="margin: 0;">Change Password</h3>
          </div>
          <form action="/student/changepassword" method="POST" id="passwordModalForm">
              <div class="form-group" style="position: relative;">
                  <label>Current Password</label>
                  <input type="password" id="modalCurrentPassword" name="currentPassword" class="form-control" required style="padding-right: 40px;">
                  <button type="button" onclick="togglePasswordVisibility('modalCurrentPassword')" style="position: absolute; right: 12px; top: 38px; background: none; border: none; color: var(--text-muted); cursor: pointer;">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  </button>
              </div>
              <div class="form-group" style="position: relative;">
                  <label>New Password</label>
                  <input type="password" id="modalNewPassword" name="newPassword" class="form-control" required minlength="6" style="padding-right: 40px;" oninput="checkModalPasswordStrength()">
                  <button type="button" onclick="togglePasswordVisibility('modalNewPassword')" style="position: absolute; right: 12px; top: 38px; background: none; border: none; color: var(--text-muted); cursor: pointer;">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  </button>
                  <div style="height: 4px; background: var(--glass-border); border-radius: 2px; margin-top: 8px; overflow: hidden;">
                      <div id="modalPasswordStrengthBar" style="height: 100%; width: 0%; background: #ef4444; transition: 0.3s;"></div>
                  </div>
                  <p id="modalPasswordStrengthText" style="font-size: 0.7rem; color: var(--text-muted); margin-top: 4px; text-align: right;">Strength</p>
              </div>
              <div class="form-group" style="position: relative; margin-bottom: 24px;">
                  <label>Confirm Password</label>
                  <input type="password" id="modalConfirmPassword" name="confirmPassword" class="form-control" required minlength="6" style="padding-right: 40px;" oninput="checkModalPasswordMatch()">
                  <button type="button" onclick="togglePasswordVisibility('modalConfirmPassword')" style="position: absolute; right: 12px; top: 38px; background: none; border: none; color: var(--text-muted); cursor: pointer;">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  </button>
                  <p id="modalPasswordMatchError" style="font-size: 0.75rem; color: #ef4444; margin-top: 4px; display: none;">Passwords do not match</p>
              </div>
              <div style="display: flex; gap: 12px; justify-content: flex-end;">
                  <button type="button" onclick="closeChangePasswordModal()" style="padding: 10px 20px; background: transparent; color: var(--text-muted); border: none; cursor: pointer; font-size: 0.9rem;">Cancel</button>
                  <button type="submit" id="modalUpdatePasswordBtn" style="padding: 10px 20px; background: linear-gradient(135deg, var(--primary), var(--accent)); color: #ffffff; border: none; border-radius: 8px; cursor: pointer; font-size: 0.9rem; font-weight: 600;">Update Password</button>
              </div>
          </form>
      </div>
  </div>

  <script>
    function openChangePasswordModal() {
        document.getElementById('changePasswordModal').classList.add('active');
        document.getElementById('modalCurrentPassword').value = '';
        document.getElementById('modalNewPassword').value = '';
        document.getElementById('modalConfirmPassword').value = '';
        document.getElementById('modalPasswordStrengthBar').style.width = '0%';
        document.getElementById('modalPasswordStrengthText').innerText = 'Strength';
        document.getElementById('modalPasswordMatchError').style.display = 'none';
        document.getElementById('modalUpdatePasswordBtn').disabled = false;
    }

    function closeChangePasswordModal() {
        document.getElementById('changePasswordModal').classList.remove('active');
    }

    function checkModalPasswordStrength() {
        const pwd = document.getElementById('modalNewPassword').value;
        const bar = document.getElementById('modalPasswordStrengthBar');
        const text = document.getElementById('modalPasswordStrengthText');
        
        let strength = 0;
        if (pwd.length > 5) strength += 1;
        if (pwd.length > 7) strength += 1;
        if (/[A-Z]/.test(pwd)) strength += 1;
        if (/[0-9]/.test(pwd)) strength += 1;
        if (/[^A-Za-z0-9]/.test(pwd)) strength += 1;

        if (pwd.length === 0) {
            bar.style.width = '0%';
            text.innerText = 'Strength';
        } else if (strength < 2) {
            bar.style.width = '33%';
            bar.style.background = '#ef4444'; // Red
            text.innerText = 'Weak';
        } else if (strength < 4) {
            bar.style.width = '66%';
            bar.style.background = '#eab308'; // Yellow
            text.innerText = 'Medium';
        } else {
            bar.style.width = '100%';
            bar.style.background = '#22c55e'; // Green
            text.innerText = 'Strong';
        }
        checkModalPasswordMatch();
    }

    function checkModalPasswordMatch() {
        const newPwd = document.getElementById('modalNewPassword').value;
        const confirmPwd = document.getElementById('modalConfirmPassword').value;
        const errorMsg = document.getElementById('modalPasswordMatchError');
        const btn = document.getElementById('modalUpdatePasswordBtn');

        if (confirmPwd.length > 0 && newPwd !== confirmPwd) {
            errorMsg.style.display = 'block';
            btn.disabled = true;
        } else {
            errorMsg.style.display = 'none';
            btn.disabled = false;
        }
    }
  </script>

  <!-- Global Loader -->
  <div id="global-loader" class="loader-overlay">
    <div class="spinner"></div>
    <div class="loader-text">Processing...</div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const forms = document.querySelectorAll("form");
      const loader = document.getElementById("global-loader");
      
      forms.forEach(form => {
        form.addEventListener("submit", async function(e) {
          if (!form.checkValidity()) return;
          
          const isAjax = form.id === 'summaryForm' || form.id === 'editSummaryForm';
          if (isAjax) {
              e.preventDefault();
          }
          
          loader.classList.add("active");
          const buttons = form.querySelectorAll("button[type='submit']");
          const originalTexts = [];
          
          buttons.forEach(btn => {
              originalTexts.push(btn.innerText);
              btn.disabled = true;
              btn.innerText = 'Processing...';
              btn.style.opacity = '0.7';
              btn.style.cursor = 'not-allowed';
          });
          
          if (isAjax) {
              try {
                  const response = await fetch(form.action, {
                      method: form.method,
                      body: new FormData(form),
                      headers: { 'Accept': 'application/json' }
                  });
                  const result = await response.json();
                  
                  if (result.success) {
                      window.location.reload();
                  } else {
                      loader.classList.remove("active");
                      buttons.forEach((btn, i) => {
                          btn.disabled = false;
                          btn.innerText = originalTexts[i] || 'Submit';
                          btn.style.opacity = '1';
                          btn.style.cursor = 'pointer';
                      });
                      if (typeof Toastify !== 'undefined') {
                          Toastify({
                              text: result.message,
                              duration: 3000,
                              gravity: "top",
                              position: "right",
                              style: { background: "#ef4444", borderRadius: "8px" }
                          }).showToast();
                      } else {
                          alert(result.message);
                      }
                  }
              } catch (err) {
                  loader.classList.remove("active");
                  buttons.forEach((btn, i) => {
                      btn.disabled = false;
                      btn.innerText = originalTexts[i] || 'Submit';
                      btn.style.opacity = '1';
                      btn.style.cursor = 'pointer';
                  });
                  if (typeof Toastify !== 'undefined') {
                      Toastify({
                          text: "A network error occurred.",
                          duration: 3000,
                          gravity: "top",
                          position: "right",
                          style: { background: "#ef4444", borderRadius: "8px" }
                      }).showToast();
                  } else {
                      alert("A network error occurred.");
                  }
              }
          }
        });
      });
    });
  </script>

</body>
</html>
