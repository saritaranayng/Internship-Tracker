      <div style="background: var(--card-bg); padding: 32px; border-radius: 16px; border: 1px solid var(--glass-border); width: 90%; max-width: 500px; backdrop-filter: blur(20px);">
          <h3 id="submitModalTitle" style="margin-bottom: 24px;">Submit Weekly Log</h3>
          <form id="submitLogForm" action="/student/submitlog" method="POST" enctype="multipart/form-data">
              <div class="form-group">
                  <label>Week Number</label>
                  <input type="number" id="submitWeek" name="week" class="form-control" required placeholder="e.g. 1">
              </div>
              <div class="form-group">
                  <label>Description</label>
                  <textarea id="submitDesc" name="description" class="form-control" rows="4" style="resize: none;" required placeholder="What did you learn this week?"></textarea>
              </div>
              <div class="form-group" style="margin-bottom: 24px;">
                  <label id="submitFileLabel">Supporting File (PDF/Image)</label>
                  <input type="file" id="submitFile" name="logFile" class="form-control" required>
              </div>
              <div style="display: flex; gap: 12px; justify-content: flex-end;">
                  <button type="button" onclick="closeSubmitModal()" style="padding: 10px 20px; background: transparent; color: var(--text-muted); border: none; cursor: pointer; font-size: 0.9rem;">Cancel</button>
                  <button type="submit" id="submitModalBtn" style="padding: 10px 20px; background: linear-gradient(135deg, var(--primary), var(--accent)); color: #ffffff; border: none; border-radius: 8px; cursor: pointer; font-size: 0.9rem; font-weight: 600;">Submit Entry</button>
              </div>
