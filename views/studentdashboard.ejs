  <script>
    let currentLogId = null;

    function openCreateModal() {
        document.getElementById('submitModalTitle').innerText = 'Submit Weekly Log';
        document.getElementById('submitLogForm').action = '/student/submitlog';
        document.getElementById('submitFile').name = 'logFile';
        document.getElementById('submitFile').required = true;
        document.getElementById('submitFileLabel').innerText = 'Supporting File (PDF/Image)';
        document.getElementById('submitModalBtn').innerText = 'Submit Entry';
        
        document.getElementById('submitWeek').value = '';
        document.getElementById('submitDesc').value = '';
        
        document.getElementById('submitModal').classList.add('active');
    }

    function closeSubmitModal() {
        document.getElementById('submitModal').classList.remove('active');
    }

    function openViewEditModal(btn) {
        const id = btn.getAttribute('data-id');
        const week = btn.getAttribute('data-week');
        const status = btn.getAttribute('data-status');
        const fileUrl = btn.getAttribute('data-file');
        
        // Find desc and feedback in sibling elements
        const td = btn.closest('td');
        const desc = td.querySelector('.hidden-desc').innerText;
        const feedback = td.querySelector('.hidden-feedback').innerText;

        currentLogId = id;
        document.getElementById('viewEditLogForm').action = '/student/editlog/' + currentLogId;

        document.getElementById('viewEditWeek').value = week;
        document.getElementById('viewEditDesc').value = desc;

        // Reset to read-only mode
        document.getElementById('viewEditWeek').readOnly = true;
        document.getElementById('viewEditDesc').readOnly = true;
        document.getElementById('viewEditFile').disabled = true;
        document.getElementById('viewEditFile').style.display = 'none'; // Hide input entirely in view mode
        
        const updateBtn = document.getElementById('viewEditUpdateBtn');
        updateBtn.disabled = true;
        
        const editBtn = document.getElementById('enableEditBtn');
        if (status === 'Approved') {
            editBtn.style.display = 'none';
        } else {
            editBtn.style.display = 'flex';
        }

        const fileContainer = document.getElementById('currentFileLinkContainer');
        if (fileUrl && fileUrl.trim() !== '') {
            fileContainer.style.display = 'block';
            document.getElementById('currentFileLink').href = fileUrl;
        } else {
            fileContainer.style.display = 'none';
        }

        const fbContainer = document.getElementById('viewEditFeedbackContainer');
        if (feedback && feedback.trim() !== '') {
            fbContainer.style.display = 'block';
            document.getElementById('viewEditFeedback').innerText = feedback;
            if(status.toLowerCase() === 'approved') {
                document.getElementById('viewEditFeedback').style.color = '#10b981';
                document.getElementById('viewEditFeedback').style.background = 'rgba(16, 185, 129, 0.1)';
                document.getElementById('viewEditFeedback').style.border = '1px solid rgba(16, 185, 129, 0.2)';
            } else {
                document.getElementById('viewEditFeedback').style.color = '#ef4444';
                document.getElementById('viewEditFeedback').style.background = 'rgba(239, 68, 68, 0.1)';
                document.getElementById('viewEditFeedback').style.border = '1px solid rgba(239, 68, 68, 0.2)';
            }
        } else {
            fbContainer.style.display = 'none';
        }

        document.getElementById('viewEditModalTitle').innerText = 'Log Details';
        document.getElementById('viewEditModal').classList.add('active');
    }

    function enableEditMode() {
        document.getElementById('viewEditModalTitle').innerText = 'Update Log Details';
        document.getElementById('viewEditWeek').readOnly = false;
        document.getElementById('viewEditDesc').readOnly = false;
        document.getElementById('viewEditFile').disabled = false;
        document.getElementById('viewEditFile').style.display = 'block'; // Show file input when editing
        
        const updateBtn = document.getElementById('viewEditUpdateBtn');
        updateBtn.disabled = false;
    }

    function closeViewEditModal() {
        document.getElementById('viewEditModal').classList.remove('active');
    }

    function openDeleteModal(id) {
        document.getElementById('confirmDeleteForm').action = '/student/deletelog/' + id;
        document.getElementById('deleteModal').classList.add('active');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.remove('active');
    }
  </script>

