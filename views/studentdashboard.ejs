<!DOCTYPE html>
<html>
<head>
    <title>Student Dashboard</title>
    <style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background-color: #f4f6f8;
        margin: 0;
        padding: 0;
    }

    header {
        background-color: #2c3e50;
        color: white;
        padding: 20px;
        text-align: center;
    }

    .container {
        padding: 30px;
        max-width: 1000px;
        margin: auto;
    }

    .card {
        background: white;
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }

    h1, h2 {
        color: #2c3e50;
    }

    label {
        font-weight: bold;
    }

    input[type="number"],
    textarea,
    input[type="file"] {
        width: 100%;
        padding: 10px;
        margin: 8px 0 16px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    button {
        padding: 10px 18px;
        background-color: #3498db;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        margin-right: 5px;
    }

    button:hover {
        background-color: #2980b9;
    }

    .delete-btn {
        background-color: #e74c3c;
    }

    .delete-btn:hover {
        background-color: #c0392b;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

    th, td {
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid #ccc;
    }

    th {
        background-color: #2c3e50;
        color: white;
    }

    .actions {
        display: flex;
        gap: 10px;
    }

    .logout {
        background-color: red;
    }
    </style>
</head>
<body>
    <div class="container">
        <h1>Welcome, <%= student.firstname %>!</h1>
        <p>Roll No: <%= student.rollno %></p>
        <p>Course: <%= student.course %></p>

        <hr>

        <h2>Submit Weekly Log</h2>
        <form action="/student/submitlog" method="POST" enctype="multipart/form-data">
            <label>Week:</label>
            <input type="number" name="week" required>

            <label>Description:</label>
            <textarea name="description" rows="4" required></textarea>

            <label>Upload File:</label>
            <input type="file" name="logFile" required><br>

            <button type="submit">Submit Log</button>
        </form>

        <hr>

        <h2>Your Logs</h2>
        <% if (logs.length === 0) { %>
            <p>No logs submitted yet.</p>
        <% } else { %>
            <table>
                <tr>
                    <th>Week</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>File</th>
                    <th>Actions</th>
                </tr>
                <% logs.forEach(log => { %>
                    <tr>
                        <td><%= log.week %></td>
                        <td><%= log.description %></td>
                        <td><%= log.status %></td>
                        <td><%= log.date.toDateString() %></td>
                        <td>
                            <% if (log.file) { %>
                                <a href="/uploads/<%= log.file %>" target="_blank">View</a>
                            <% } else { %>
                                No File
                            <% } %>
                        </td>
                        <td class="actions">
                            <a href="/student/editlog/<%= log._id %>">
                                <button>Edit</button>
                            </a>
                            <form action="/student/deletelog/<%= log._id %>" method="POST" style="display:inline;">
                                <button type="submit" class="delete-btn" onclick="return confirm('Are you sure you want to delete this log?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </table>
        <% } %>

        <hr>
        <form action="/student/logout" method="GET">
            <button type="submit" class="logout">Logout</button>
        </form>
    </div>
    <% if (message) { %>
  <script>
    alert("<%= message %>");
  </script>
<% } %>

<!-- Footer -->
  <%- include('partials/footer') %>
</body>
</html>
