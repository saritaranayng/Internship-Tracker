<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Final Internship Report | <%= student.firstname %> <%= student.lastname %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --primary: #6366f1;
            --accent: #a855f7;
            --bg-darker: #0f0f1b;
            --card-bg: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.08);
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
        }

        body {
            background: #fafafa;
            color: #1f2937;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 40px 20px;
            line-height: 1.5;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            background: #ffffff;
            padding: 50px;
            border-radius: 16px;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
            border: 1px solid #e5e7eb;
            position: relative;
        }

        .header-title {
            text-align: center;
            margin-bottom: 40px;
            border-bottom: 2px solid #374151;
            padding-bottom: 20px;
        }

        .header-title h1 {
            margin: 0;
            font-size: 2.2rem;
            color: #111827;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .header-title p {
            margin: 8px 0 0;
            color: #4b5563;
            font-size: 1.1rem;
        }

        .section-title {
            font-size: 1.3rem;
            color: #111827;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 8px;
            margin-top: 30px;
            margin-bottom: 16px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .grid-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .info-item {
            font-size: 0.95rem;
        }

        .info-item strong {
            color: #374151;
            display: inline-block;
            width: 150px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
        }

        .stat-card h4 {
            margin: 0;
            font-size: 0.85rem;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-card p {
            margin: 10px 0 0;
            font-size: 1.75rem;
            font-weight: 700;
            color: #111827;
        }

        .skills-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 30px;
        }

        .skill-tag {
            background: #eff6ff;
            color: #1e40af;
            border: 1px solid #bfdbfe;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .summary-block {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
            background: #f9fafb;
            page-break-inside: avoid;
        }

        .summary-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 10px;
            margin-bottom: 12px;
        }

        .summary-header h3 {
            margin: 0;
            font-size: 1.1rem;
            color: #111827;
        }

        .summary-badge {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 4px;
            text-transform: uppercase;
        }

        .badge-approved { background: #d1fae5; color: #065f46; }
        .badge-pending { background: #fef3c7; color: #92400e; }
        .badge-changes { background: #fee2e2; color: #991b1b; }

        .summary-body {
            font-size: 0.9rem;
            color: #374151;
        }

        .summary-body p {
            margin: 6px 0;
        }

        .feedback-box {
            margin-top: 12px;
            padding: 10px;
            background: #fff;
            border-left: 3px solid #6366f1;
            font-style: italic;
            font-size: 0.85rem;
            color: #4b5563;
        }

        .actions-bar {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 20px;
        }

        .print-btn {
            background: #6366f1;
            color: #ffffff;
            border: none;
            padding: 10px 20px;
            font-size: 0.95rem;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .print-btn:hover {
            background: #4f46e5;
        }

        @media print {
            body {
                background: #ffffff;
                padding: 0;
                color: #000000;
            }
            .container {
                box-shadow: none;
                border: none;
                padding: 0;
            }
            .actions-bar {
                display: none;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        
        <!-- Actions (Hidden in Print) -->
        <div class="actions-bar">
            <button onclick="window.print()" class="print-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                    <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                Print Report
            </button>
        </div>

        <!-- Report Header -->
        <div class="header-title">
            <h1>Final Internship Report</h1>
            <p>Academic Year: <%= new Date().getFullYear() %></p>
        </div>

        <!-- Student & Company Profile -->
        <div class="section-title">Student Profile</div>
        <div class="grid-info">
            <div>
                <div class="info-item"><strong>Student Name:</strong> <%= student.firstname %> <%= student.lastname %></div>
                <div class="info-item"><strong>Roll Number:</strong> <%= student.rollno %></div>
                <div class="info-item"><strong>Department:</strong> <%= student.department %></div>
                <div class="info-item"><strong>Email ID:</strong> <%= student.email %></div>
            </div>
            <div>
                <div class="info-item"><strong>Company Name:</strong> <%= student.internship ? student.internship.companyName : 'N/A' %></div>
                <div class="info-item"><strong>Role:</strong> <%= student.internship ? student.internship.role : 'N/A' %></div>
                <div class="info-item"><strong>Duration:</strong> <%= student.internship ? student.internship.duration : 'N/A' %></div>
                <div class="info-item"><strong>GitHub Repo:</strong> <%= student.internship && student.internship.gitLink ? student.internship.gitLink : 'N/A' %></div>
            </div>
        </div>

        <!-- Analytics / Stats -->
        <div class="section-title">Internship Metrics</div>
        <div class="stats-grid">
            <div class="stat-card">
                <h4>Total Task Logs</h4>
                <p><%= totalTasks %></p>
            </div>
            <div class="stat-card">
                <h4>Total Hours Logged</h4>
                <p><%= totalHours %> hrs</p>
            </div>
            <div class="stat-card">
                <h4>Evaluation Status</h4>
                <p style="color: <%= finalStatus === 'Completed' ? '#059669' : '#d97706' %>"><%= finalStatus %></p>
            </div>
        </div>

        <!-- Skills Learned -->
        <div class="section-title">Skills & Competency List</div>
        <div class="skills-container">
            <% if (skillsLearnedList && skillsLearnedList.length > 0) { %>
                <% skillsLearnedList.forEach(skill => { %>
                    <span class="skill-tag"><%= skill %></span>
                <% }) %>
            <% } else { %>
                <div style="color: #6b7280; font-style: italic;">No skills logged yet.</div>
            <% } %>
        </div>

        <!-- Weekly Summary Logs -->
        <div class="section-title">Weekly Summaries & Evaluations</div>
        <% if (weeklySummaries && weeklySummaries.length > 0) { %>
            <% weeklySummaries.forEach(sum => { %>
                <div class="summary-block">
                    <div class="summary-header">
                        <h3>Week <%= sum.week %> Summary</h3>
                        <% 
                           let badgeClass = 'badge-pending';
                           if(sum.status === 'Approved') badgeClass = 'badge-approved';
                           if(sum.status === 'Changes Requested') badgeClass = 'badge-changes';
                        %>
                        <span class="summary-badge <%= badgeClass %>"><%= sum.status %></span>
                    </div>
                    <div class="summary-body">
                        <p><strong>Work Completed:</strong> <%= sum.workCompleted %></p>
                        <p><strong>Challenges faced:</strong> <%= sum.challengesFaced %></p>
                        <p><strong>How challenges solved:</strong> <%= sum.challengesSolved %></p>
                        <p><strong>Skills demonstrated:</strong> <%= sum.skillsLearned %></p>
                        <p><strong>Goals for next week:</strong> <%= sum.goalsNextWeek %></p>
                        
                        <% if(sum.feedback && sum.feedback.trim()) { %>
                            <div class="feedback-box">
                                <strong>Faculty Feedback:</strong> "<%= sum.feedback %>"
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div style="text-align: center; padding: 40px; color: #6b7280; font-style: italic; border: 1px solid #e5e7eb; border-radius: 8px;">
                No weekly summaries submitted yet.
            </div>
        <% } %>

    </div>

</body>
</html>
