<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Faculty Dashboard | Skill Record</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <style>
        .page-layout { display: flex; min-height: 100vh; }
        .sidebar { width: 250px; background: rgba(255,255,255,0.05); border-right: 1px solid rgba(255,255,255,0.1); padding: 20px; display: flex; flex-direction: column; }
        .sidebar-logo { font-size: 1.5rem; font-weight: bold; margin-bottom: 40px; color: #fff; }
        .sidebar-logo span { color: var(--accent); }
        .nav-link { padding: 12px 16px; margin-bottom: 8px; border-radius: 8px; color: var(--text-muted); cursor: pointer; transition: 0.3s; }
        .nav-link:hover, .nav-link.active { background: rgba(255,255,255,0.1); color: #fff; }
        .main-content { flex: 1; padding: 30px; overflow-y: auto; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .analytics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
        .analytic-card { background: rgba(255,255,255,0.03); padding: 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); }
        .analytic-card h4 { color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase; margin-bottom: 10px; }
        .analytic-card p { font-size: 1.5rem; font-weight: bold; }
        .notif-btn { position: relative; background: none; border: none; color: #fff; font-size: 1.2rem; cursor: pointer; }
        .notif-badge { position: absolute; top: -5px; right: -5px; background: #ef4444; color: #fff; font-size: 0.6rem; width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
        .notif-dropdown { display: none; position: absolute; right: 0; top: 30px; width: 300px; background: #1a1a2e; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 10px; z-index: 100; max-height: 300px; overflow-y: auto; }
        .notif-dropdown.show { display: block; }
        .notif-item { padding: 10px; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.85rem; }
        .notif-item:last-child { border-bottom: none; }
        .notif-item .date { font-size: 0.7rem; color: var(--text-muted); margin-top: 4px; }
    </style>
</head>
<body style="background: var(--bg-darker);">

    <div class="page-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-logo">Skill <span>Record</span></div>
            <div class="nav-link active" onclick="switchTab('dashboard')">Dashboard</div>
            <div class="nav-link" onclick="switchTab('report')">Reports Review</div>
            <div class="nav-link" onclick="switchTab('settings')">Settings</div>
            
            <div style="margin-top: auto;">
                <form action="/faculty/logout" method="POST">
                    <button type="submit" class="cta-btn cta-btn-secondary" style="width: 100%; padding: 10px; font-size: 0.9rem;">Sign Out</button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="main-content">
            <div class="top-bar">
                <h2 id="page-title">Dashboard</h2>
                <div style="display: flex; align-items: center; gap: 20px;">
                    <div style="position: relative;">
                        <button class="notif-btn" onclick="document.getElementById('notif-dropdown').classList.toggle('show')">
                            🔔
                            <% if (typeof notifications !== 'undefined' && notifications.length > 0) { %>
                                <span class="notif-badge"><%= notifications.length %></span>
                            <% } %>
                        </button>
                        <div id="notif-dropdown" class="notif-dropdown">
                            <% if (typeof notifications !== 'undefined' && notifications.length > 0) { %>
                                <% notifications.forEach(n => { %>
                                    <div class="notif-item">
                                        <div><%= n.message %></div>
                                        <div class="date"><%= new Date(n.createdAt).toLocaleString() %></div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="notif-item" style="text-align: center; color: var(--text-muted);">No new notifications</div>
                            <% } %>
                        </div>
                    </div>
                    <div style="text-align: right;">
                        <p style="font-size: 0.9rem; font-weight: bold;"><%= staff.firstname %> <%= staff.lastname %></p>
                        <p style="font-size: 0.75rem; color: var(--text-muted);">Mentor</p>
                    </div>
                </div>
            </div>

            <!-- Dashboard Tab -->
            <div id="tab-dashboard" class="tab-content active">
                <div class="analytics-grid">
                    <% 
                       let total = students.length;
                       let pending = students.filter(s => s.status === 'Pending').length;
                       let evaluated = total - pending;
                    %>
                    <div class="analytic-card">
                        <h4>Total Submissions</h4>
                        <p><%= total %></p>
                    </div>
                    <div class="analytic-card">
                        <h4>Pending Review</h4>
                        <p style="color: #eab308;"><%= pending %></p>
                    </div>
                    <div class="analytic-card">
                        <h4>Evaluated</h4>
                        <p style="color: #10b981;"><%= evaluated %></p>
                    </div>
                    <div class="analytic-card">
                        <h4>Department</h4>
                        <p style="font-size: 1.1rem; margin-top: 5px;"><%= staff.department %></p>
                    </div>
                </div>
                
                <div class="profile-card">
                    <h3>Recent Submissions</h3>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 10px;">Go to Reports Review tab to view and evaluate student log submissions.</p>
                </div>
            </div>

            <!-- Reports Tab -->
            <div id="tab-report" class="tab-content">
                <div class="profile-card" style="min-height: 500px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                        <h3>Student Submissions</h3>
                        <div style="display: flex; gap: 16px; align-items: center;">
                            <select id="statusFilter" onchange="filterTable()" style="background: rgba(255,255,255,0.05); color: white; border: 1px solid var(--glass-border); border-radius: 8px; padding: 6px 12px; font-size: 0.85rem; outline: none; appearance: auto;">
                                <option value="all" style="color: black;">All Submissions</option>
                                <option value="pending" style="color: black;">Pending</option>
                                <option value="approved" style="color: black;">Approved</option>
                                <option value="changes-requested" style="color: black;">Changes Requested</option>
                            </select>
                            <span style="font-size: 0.8rem; background: rgba(255,255,255,0.05); padding: 4px 12px; border-radius: 20px;" id="totalCountDisplay">
                                <%= students.length %> Total
                            </span>
                        </div>
                    </div>
                    
                    <% if (students && students.length > 0) { %>
                        <div style="overflow-x: auto;">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Student Name</th>
                                        <th>Roll Number</th>
                                        <th>Week</th>
                                        <th>Work Completed</th>
                                        <th>Date Submitted</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% students.forEach(item => { %>
                                        <tr class="log-row" data-status="<%= item.status.toLowerCase().replace(' ', '-') %>">
                                            <td style="font-weight: 600;"><%= item.name %></td>
                                            <td><%= item.student.rollno %></td>
                                            <td style="font-weight: 600;">W-<%= item.week %></td>
                                            <td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= item.workCompleted %></td>
                                            <td style="font-size: 0.85rem; color: var(--text-muted);"><%= item.date %></td>
                                            <td>
                                                <span class="status-badge status-<%= item.status.toLowerCase().replace(' ', '-') %>">
                                                    <%= item.status %>
                                                </span>
                                            </td>
                                            <td>
                                                <script type="application/json" id="tasks-<%= item._id %>"><%- JSON.stringify(item.tasks) %></script>
                                                <button onclick="openReviewModal(this)"
                                                        data-id="<%= item._id %>"
                                                        data-name="<%= item.name %>"
                                                        data-roll="<%= item.student.rollno %>"
                                                        data-week="<%= item.week %>"
                                                        data-completed="<%= item.workCompleted %>"
                                                        data-challenges="<%= item.challengesFaced %>"
                                                        data-solutions="<%= item.challengesSolved %>"
                                                        data-skills="<%= item.skillsLearned %>"
                                                        data-goals="<%= item.goalsNextWeek %>"
                                                        data-status="<%= item.status %>"
                                                        data-feedback="<%= item.feedback || '' %>"
                                                        data-allowedits="<%= item.allowTaskEdits %>"
                                                        style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.2); color: var(--primary); padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
                                                    Review
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div style="text-align: center; padding: 60px 20px; color: var(--text-muted);">
                            <p>No student submissions found for your department.</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Settings Tab -->
            <div id="tab-settings" class="tab-content">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start;">
                    <div class="profile-card">
                        <h3 style="margin-bottom: 20px;">Faculty Profile</h3>
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <label style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Full Name</label>
                                <p><%= staff.firstname %> <%= staff.lastname %></p>
                            </div>
                            <div>
                                <label style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Designation</label>
                                <p><%= staff.designation %></p>
                            </div>
                            <div>
                                <label style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Department</label>
                                <p><%= staff.department %></p>
                            </div>
                            <div>
                                <label style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Email</label>
                                <p><%= staff.email %></p>
                            </div>
                        </div>
                    </div>

                    <div class="profile-card">
                        <h3 style="margin-bottom: 20px;">Change Password</h3>
                        <form action="/faculty/changepassword" method="POST">
                            <div class="form-group">
                                <label>Current Password</label>
                                <input type="password" name="currentPassword" class="form-control" required>
                            </div>
                            <div class="form-group">
                                <label>New Password</label>
                                <input type="password" name="newPassword" class="form-control" required minlength="6">
                            </div>
                            <button type="submit" class="auth-btn">Update Password</button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-link').forEach(el => el.classList.remove('active'));
            
            document.getElementById('tab-' + tabId).classList.add('active');
            event.currentTarget.classList.add('active');
            
            const titles = {
                'dashboard': 'Dashboard',
                'report': 'Reports Review',
                'settings': 'Settings'
            };
            document.getElementById('page-title').innerText = titles[tabId];
        }

        // Close dropdown when clicking outside
        window.onclick = function(event) {
            if (!event.target.matches('.notif-btn')) {
                var dropdowns = document.getElementsByClassName("notif-dropdown");
                for (var i = 0; i < dropdowns.length; i++) {
                    var openDropdown = dropdowns[i];
                    if (openDropdown.classList.contains('show')) {
                        openDropdown.classList.remove('show');
                    }
                }
            }
        }
    </script>
    
    <% if (typeof message !== 'undefined' && message) { %>
      <script>
        document.addEventListener("DOMContentLoaded", function() {
            const msg = "<%= message %>";
            const isError = msg.toLowerCase().includes('error') || msg.toLowerCase().includes('incorrect') || msg.toLowerCase().includes('fail');
            Toastify({
                text: msg,
                duration: 3000,
                gravity: "top",
                position: "right",
                style: {
                    background: isError ? "#ef4444" : "#10b981",
                    borderRadius: "8px",
                    boxShadow: "0 4px 12px rgba(0,0,0,0.15)"
                }
            }).showToast();
        });
      </script>
    <% } %>

  <!-- Review Weekly Summary Modal -->
  <div id="reviewModal" class="loader-overlay" style="z-index: 10000; align-items: center; justify-content: center;">
    <div style="background: var(--card-bg); padding: 32px; border-radius: 16px; border: 1px solid var(--glass-border); width: 90%; max-width: 750px; backdrop-filter: blur(20px); max-height: 90vh; overflow-y: auto;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; border-bottom: 1px solid var(--glass-border); padding-bottom: 16px;">
            <h3 style="margin: 0;">Review Submission</h3>
            <span id="reviewStatusBadge" class="status-badge"></span>
        </div>
        
        <!-- Student Info -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; background: rgba(255,255,255,0.02); padding: 16px; border-radius: 8px; border: 1px solid var(--glass-border);">
            <div>
                <label style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Student Name</label>
                <p id="reviewStudentName" style="margin: 4px 0 0; font-weight: 600;"></p>
            </div>
            <div>
                <label style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Roll Number</label>
                <p id="reviewStudentRoll" style="margin: 4px 0 0; font-weight: 600;"></p>
            </div>
        </div>

        <!-- Weekly Summary Details -->
        <h4 style="margin-top: 0; margin-bottom: 12px; color: var(--primary);">Weekly Summary (Week <span id="reviewWeekNum"></span>)</h4>
        <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 24px; background: rgba(255,255,255,0.02); padding: 16px; border-radius: 8px; border: 1px solid var(--glass-border);">
            <div>
                <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-main);">Work Completed:</label>
                <p id="reviewWorkCompleted" style="margin: 4px 0 0; font-size: 0.9rem; line-height: 1.4; color: var(--text-muted);"></p>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div>
                    <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-main);">Challenges Faced:</label>
                    <p id="reviewChallenges" style="margin: 4px 0 0; font-size: 0.9rem; line-height: 1.4; color: var(--text-muted);"></p>
                </div>
                <div>
                    <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-main);">How Solved:</label>
                    <p id="reviewSolutions" style="margin: 4px 0 0; font-size: 0.9rem; line-height: 1.4; color: var(--text-muted);"></p>
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div>
                    <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-main);">Skills Learned:</label>
                    <p id="reviewSkills" style="margin: 4px 0 0; font-size: 0.9rem; color: var(--text-muted);"></p>
                </div>
                <div>
                    <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-main);">Goals for Next Week:</label>
                    <p id="reviewGoals" style="margin: 4px 0 0; font-size: 0.9rem; line-height: 1.4; color: var(--text-muted);"></p>
                </div>
            </div>
        </div>

        <!-- Collapsible Daily Task Logs Section -->
        <div style="margin-bottom: 24px;">
            <button onclick="toggleReviewTasks()" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: rgba(99, 102, 241, 0.05); border: 1px solid rgba(99, 102, 241, 0.15); padding: 12px 16px; border-radius: 8px; color: var(--primary); cursor: pointer; font-weight: 600; font-size: 0.9rem;">
                <span>Show/Hide Daily Task Logs (<span id="reviewTaskCount">0</span>)</span>
                <span id="reviewTaskArrow">▼</span>
            </button>
            <div id="reviewTasksContainer" style="display: none; margin-top: 12px; max-height: 250px; overflow-y: auto; border: 1px solid var(--glass-border); border-radius: 8px; background: rgba(0,0,0,0.1);">
                <table class="data-table" style="margin: 0; width: 100%;">
                    <thead>
                        <tr>
                            <th>Date & Title</th>
                            <th>Description</th>
                            <th>Hours</th>
                            <th>Status</th>
                            <th>Links</th>
                        </tr>
                    </thead>
                    <tbody id="reviewTasksTableBody">
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Faculty Feedback & Action Form -->
        <form id="reviewActionForm" method="POST" style="margin: 0;">
            <div class="form-group">
                <label>Remarks / Feedback *</label>
                <textarea name="feedback" id="reviewFeedbackText" rows="3" class="form-control" style="resize: none;" placeholder="Provide remarks or details of requested changes..."></textarea>
            </div>
            
            <div id="allowEditsContainer" class="form-group" style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
                <input type="checkbox" name="allowTaskEdits" id="reviewAllowEdits" style="width: auto; margin: 0;">
                <label for="reviewAllowEdits" style="margin: 0; font-size: 0.85rem; font-weight: normal; cursor: pointer;">Allow student to edit daily tasks for this week</label>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end; align-items: center;">
                <button type="button" onclick="closeReviewModal()" style="padding: 10px 20px; background: transparent; color: var(--text-muted); border: none; cursor: pointer; font-size: 0.9rem;">Cancel</button>
                <div style="display: flex; gap: 12px;">
                    <button type="button" onclick="submitReviewAction('request-changes')" style="padding: 10px 20px; background: #eab308; color: #000; border: none; border-radius: 8px; cursor: pointer; font-size: 0.9rem; font-weight: 600;">Request Changes</button>
                    <button type="button" onclick="submitReviewAction('approve')" style="padding: 10px 20px; background: #10b981; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 0.9rem; font-weight: 600;">Approve</button>
                </div>
            </div>
        </form>
    </div>
  </div>

  <script>
    let currentSummaryId = null;

    function openReviewModal(btn) {
        currentSummaryId = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        const roll = btn.getAttribute('data-roll');
        const week = btn.getAttribute('data-week');
        const completed = btn.getAttribute('data-completed');
        const challenges = btn.getAttribute('data-challenges');
        const solutions = btn.getAttribute('data-solutions');
        const skills = btn.getAttribute('data-skills');
        const goals = btn.getAttribute('data-goals');
        const status = btn.getAttribute('data-status');
        const feedback = btn.getAttribute('data-feedback');
        const allowEdits = btn.getAttribute('data-allowedits') === 'true';

        document.getElementById('reviewStudentName').innerText = name;
        document.getElementById('reviewStudentRoll').innerText = roll;
        document.getElementById('reviewWeekNum').innerText = week;
        document.getElementById('reviewWorkCompleted').innerText = completed;
        document.getElementById('reviewChallenges').innerText = challenges;
        document.getElementById('reviewSolutions').innerText = solutions;
        document.getElementById('reviewSkills').innerText = skills;
        document.getElementById('reviewGoals').innerText = goals;
        document.getElementById('reviewFeedbackText').value = feedback;
        document.getElementById('reviewAllowEdits').checked = allowEdits;

        const badge = document.getElementById('reviewStatusBadge');
        badge.innerText = status;
        badge.className = 'status-badge status-' + status.toLowerCase().replace(' ', '-');

        // Populate tasks
        const tasksScript = document.getElementById('tasks-' + currentSummaryId);
        let tasks = [];
        if (tasksScript) {
            try {
                tasks = JSON.parse(tasksScript.textContent);
            } catch(e) {
                console.error(e);
            }
        }
        
        document.getElementById('reviewTaskCount').innerText = tasks.length;
        
        const tbody = document.getElementById('reviewTasksTableBody');
        tbody.innerHTML = '';
        if (tasks.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--text-muted);">No task logs submitted for this week.</td></tr>';
        } else {
            tasks.forEach(t => {
                const dateStr = new Date(t.date).toLocaleDateString();
                let linksHtml = '';
                if (t.evidenceFile) {
                    linksHtml += `<a href="${t.evidenceFile}" target="_blank" style="color:var(--accent);text-decoration:none;font-size:0.75rem;margin-right:8px;">Evidence</a>`;
                }
                if (t.gitLink) {
                    linksHtml += `<a href="${t.gitLink}" target="_blank" style="color:var(--primary);text-decoration:none;font-size:0.75rem;margin-right:8px;">GitHub</a>`;
                }
                if (t.demoLink) {
                    linksHtml += `<a href="${t.demoLink}" target="_blank" style="color:#10b981;text-decoration:none;font-size:0.75rem;">Demo</a>`;
                }
                if (!linksHtml) linksHtml = '<span style="color:var(--text-muted);font-size:0.75rem;">None</span>';

                tbody.innerHTML += `
                    <tr>
                        <td>
                            <div style="font-weight:600;font-size:0.85rem;">${t.title}</div>
                            <div style="font-size:0.75rem;color:var(--text-muted);">${dateStr}</div>
                        </td>
                        <td style="font-size:0.8rem;line-height:1.3;max-width:200px;">${t.description}</td>
                        <td style="font-size:0.8rem;">${t.hoursWorked} hrs</td>
                        <td>
                            <span class="status-badge status-${t.status.toLowerCase().replace(' ', '-')}">${t.status}</span>
                        </td>
                        <td>${linksHtml}</td>
                    </tr>
                `;
            });
        }

        // Reset tasks visibility to closed
        document.getElementById('reviewTasksContainer').style.display = 'none';
        document.getElementById('reviewTaskArrow').innerText = '▼';

        document.getElementById('reviewModal').classList.add('active');
    }

    function toggleReviewTasks() {
        const container = document.getElementById('reviewTasksContainer');
        const arrow = document.getElementById('reviewTaskArrow');
        if (container.style.display === 'none') {
            container.style.display = 'block';
            arrow.innerText = '▲';
        } else {
            container.style.display = 'none';
            arrow.innerText = '▼';
        }
    }

    function closeReviewModal() {
        document.getElementById('reviewModal').classList.remove('active');
    }

    function submitReviewAction(action) {
        const form = document.getElementById('reviewActionForm');
        const feedback = document.getElementById('reviewFeedbackText').value.trim();

        if (action === 'request-changes') {
            if (!feedback) {
                alert('Please enter remarks/feedback explaining the requested changes.');
                return;
            }
            form.action = '/faculty/request-changes/' + currentSummaryId;
        } else {
            form.action = '/faculty/approve/' + currentSummaryId;
        }

        form.submit();
    }

    function filterTable() {
        const filter = document.getElementById('statusFilter').value;
        const rows = document.querySelectorAll('.log-row');
        let visibleCount = 0;
        
        rows.forEach(row => {
            if (filter === 'all' || row.dataset.status === filter) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });
        
        document.getElementById('totalCountDisplay').innerText = visibleCount + ' Total';
    }
  </script>

  <!-- Global Loader -->
  <div id="global-loader" class="loader-overlay">
    <div class="spinner"></div>
    <div class="loader-text">Processing...</div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const forms = document.querySelectorAll("form");
      const loader = document.getElementById("global-loader");
      
      forms.forEach(form => {
        form.addEventListener("submit", function() {
          if (form.checkValidity()) {
            loader.classList.add("active");
            const buttons = form.querySelectorAll("button[type='submit']");
            setTimeout(() => {
                buttons.forEach(btn => {
                    btn.disabled = true;
                    btn.innerText = 'Processing...';
                    btn.style.opacity = '0.7';
                    btn.style.cursor = 'not-allowed';
                });
            }, 0);
          }
        });
      });
    });
  </script>

</body>
</html>
