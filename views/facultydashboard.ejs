<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Faculty Dashboard | Skill Record</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .page-layout { display: flex; min-height: 100vh; }
        .sidebar { width: 250px; background: rgba(255,255,255,0.05); border-right: 1px solid rgba(255,255,255,0.1); padding: 20px; display: flex; flex-direction: column; }
        .sidebar-logo { font-size: 1.5rem; font-weight: bold; margin-bottom: 40px; color: #fff; }
        .sidebar-logo span { color: var(--accent); }
        .nav-link { padding: 12px 16px; margin-bottom: 8px; border-radius: 8px; color: var(--text-muted); cursor: pointer; transition: 0.3s; }
        .nav-link:hover, .nav-link.active { background: rgba(255,255,255,0.1); color: #fff; }
        .main-content { flex: 1; padding: 30px; overflow-y: auto; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .analytics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .analytic-card { background: rgba(255,255,255,0.03); padding: 20px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); }
        .analytic-card h4 { color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase; margin-bottom: 10px; }
        .analytic-card p { font-size: 1.5rem; font-weight: bold; }
        .notif-btn { position: relative; background: none; border: none; color: #fff; font-size: 1.2rem; cursor: pointer; }
        .notif-badge { position: absolute; top: -5px; right: -5px; background: #ef4444; color: #fff; font-size: 0.6rem; width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
        .notif-dropdown { display: none; position: absolute; right: 0; top: 30px; width: 300px; background: #1a1a2e; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 10px; z-index: 100; max-height: 300px; overflow-y: auto; }
        .notif-dropdown.show { display: block; }
        .notif-item { padding: 10px; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.85rem; }
        .notif-item:last-child { border-bottom: none; }
        .notif-item .date { font-size: 0.7rem; color: var(--text-muted); margin-top: 4px; }
    </style>
</head>
<body style="background: var(--bg-darker);">

    <div class="page-layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-logo">Skill <span>Record</span></div>
            <div class="nav-link active" onclick="switchTab('dashboard')">Dashboard</div>
            <div class="nav-link" onclick="switchTab('report')">Reports Review</div>
            <div class="nav-link" onclick="switchTab('students')">Students</div>
            <div class="nav-link" onclick="switchTab('settings')">Settings</div>
            
            <div style="margin-top: auto;">
                <form action="/faculty/logout" method="POST">
                    <button type="submit" class="cta-btn cta-btn-secondary" style="width: 100%; padding: 10px; font-size: 0.9rem;">Sign Out</button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="main-content">
            <div class="top-bar">
                <h2 id="page-title">Dashboard</h2>
                <div style="display: flex; align-items: center; gap: 20px;">
                    <div style="position: relative;">
                        <button class="notif-btn" onclick="document.getElementById('notif-dropdown').classList.toggle('show')">
                            🔔
                            <% if (typeof notifications !== 'undefined' && notifications.length > 0) { %>
                                <span class="notif-badge"><%= notifications.length %></span>
                            <% } %>
                        </button>
                        <div id="notif-dropdown" class="notif-dropdown">
                            <% if (typeof notifications !== 'undefined' && notifications.length > 0) { %>
                                <% notifications.forEach(n => { %>
                                    <div class="notif-item">
                                        <div><%= n.message %></div>
                                        <div class="date"><%= new Date(n.createdAt).toLocaleString() %></div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="notif-item" style="text-align: center; color: var(--text-muted);">No new notifications</div>
                            <% } %>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="text-align: right;">
                            <p style="font-size: 0.9rem; font-weight: bold;"><%= staff.firstname %> <%= staff.lastname %></p>
                            <p style="font-size: 0.75rem; color: var(--text-muted);">Mentor</p>
                        </div>
                        <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--glass); border: 1px solid var(--glass-border); overflow: hidden; display: flex; align-items: center; justify-content: center;">
                            <% if (staff.profilePicture) { %>
                                <img src="<%= staff.profilePicture.startsWith('http') ? staff.profilePicture : '/uploads/' + staff.profilePicture %>" style="width: 100%; height: 100%; object-fit: cover;" alt="Profile">
                            <% } else { %>
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dashboard Tab -->
            <div id="tab-dashboard" class="tab-content active">
                <div class="analytics-grid">
                    <% 
                       let total = students.length;
                       let pending = students.filter(s => s.status === 'Pending').length;
                       let approved = students.filter(s => s.status === 'Approved').length;
                       let changesReq = students.filter(s => s.status === 'Changes Requested').length;
                    %>
                    <div class="analytic-card">
                        <h4>Total Submissions</h4>
                        <p><%= total %></p>
                    </div>
                    <div class="analytic-card">
                        <h4>Pending Review</h4>
                        <p style="color: #eab308;"><%= pending %></p>
                    </div>
                    <div class="analytic-card">
                        <h4>Approved</h4>
                        <p style="color: #10b981;"><%= approved %></p>
                    </div>
                    <div class="analytic-card">
                        <h4>Changes Requested</h4>
                        <p style="color: #ef4444;"><%= changesReq %></p>
                    </div>
                    <div class="analytic-card">
                        <h4>Department</h4>
                        <p style="font-size: 1.1rem; margin-top: 5px;"><%= staff.department %></p>
                    </div>
                </div>
                
                <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 30px; align-items: start;">
                    <div class="profile-card">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                            <h3>Recent Submissions</h3>
                            <button onclick="switchTab('report')" class="cta-btn cta-btn-secondary" style="padding: 6px 12px; font-size: 0.8rem; background: transparent; border: 1px solid var(--accent); color: var(--accent); border-radius: 6px; cursor: pointer;">View All</button>
                        </div>
                        <% if (students && students.length > 0) { %>
                            <div style="overflow-x: auto;">
                                <table class="data-table" style="margin: 0; width: 100%;">
                                    <thead>
                                        <tr>
                                            <th>Student Name</th>
                                            <th>Week</th>
                                            <th>Date Submitted</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% students.slice(0, 5).forEach(item => { %>
                                            <tr>
                                                <td style="font-weight: 600;"><%= item.name %></td>
                                                <td style="font-weight: 600;">W-<%= item.week %></td>
                                                <td style="font-size: 0.85rem; color: var(--text-muted);"><%= item.date %></td>
                                                <td>
                                                    <span class="status-badge status-<%= item.status.toLowerCase().replace(' ', '-') %>">
                                                        <%= item.status %>
                                                    </span>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 10px;">No recent submissions found.</p>
                        <% } %>
                    </div>

                    <div class="profile-card">
                        <h3>Submissions Breakdown</h3>
                        <div style="position: relative; height: 250px; width: 100%; display: flex; justify-content: center; align-items: center; margin-top: 20px;">
                            <% if (total > 0) { %>
                                <canvas id="submissionsChart"></canvas>
                                <script>
                                    document.addEventListener("DOMContentLoaded", function() {
                                        const ctx = document.getElementById('submissionsChart').getContext('2d');
                                        new Chart(ctx, {
                                            type: 'doughnut',
                                            data: {
                                                labels: ['Pending', 'Approved', 'Changes Req.'],
                                                datasets: [{
                                                    data: [<%= pending %>, <%= approved %>, <%= changesReq %>],
                                                    backgroundColor: ['#eab308', '#10b981', '#ef4444'],
                                                    borderWidth: 0,
                                                    hoverOffset: 4
                                                }]
                                            },
                                            options: {
                                                responsive: true,
                                                maintainAspectRatio: false,
                                                cutout: '70%',
                                                plugins: {
                                                    legend: { position: 'bottom', labels: { color: '#e2e8f0', padding: 20 } }
                                                }
                                            }
                                        });
                                    });
                                </script>
                            <% } else { %>
                                <p style="color: var(--text-muted); font-size: 0.9rem;">No data to display.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reports Tab -->
            <div id="tab-report" class="tab-content">
                <div class="profile-card" style="min-height: 500px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                        <h3>Student Submissions</h3>
                        <div style="display: flex; gap: 16px; align-items: center;">
                            <select id="statusFilter" onchange="filterTable()" style="background: rgba(255,255,255,0.05); color: white; border: 1px solid var(--glass-border); border-radius: 8px; padding: 6px 12px; font-size: 0.85rem; outline: none; appearance: auto;">
                                <option value="all" style="color: black;">All Submissions</option>
                                <option value="pending" style="color: black;">Pending</option>
                                <option value="approved" style="color: black;">Approved</option>
                                <option value="changes-requested" style="color: black;">Changes Requested</option>
                            </select>
                            <span style="font-size: 0.8rem; background: rgba(255,255,255,0.05); padding: 4px 12px; border-radius: 20px;" id="totalCountDisplay">
                                <%= students.length %> Total
                            </span>
                        </div>
                    </div>
                    
                    <% if (students && students.length > 0) { %>
                        <div style="overflow-x: auto;">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Student Name</th>
                                        <th>Roll Number</th>
                                        <th>Week</th>
                                        <th>Work Completed</th>
                                        <th>Date Submitted</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% students.forEach(item => { %>
                                        <tr class="log-row" data-status="<%= item.status.toLowerCase().replace(' ', '-') %>">
                                            <td style="font-weight: 600;"><%= item.name %></td>
                                            <td><%= item.student.rollno %></td>
                                            <td style="font-weight: 600;">W-<%= item.week %></td>
                                            <td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= item.workCompleted %></td>
                                            <td style="font-size: 0.85rem; color: var(--text-muted);"><%= item.date %></td>
                                            <td>
                                                <span class="status-badge status-<%= item.status.toLowerCase().replace(' ', '-') %>">
                                                    <%= item.status %>
                                                </span>
                                            </td>
                                            <td>
                                                <script type="application/json" id="tasks-<%= item._id %>"><%- JSON.stringify(item.tasks) %></script>
                                                <button onclick="openReviewModal(this)"
                                                        data-id="<%= item._id %>"
                                                        data-name="<%= item.name %>"
                                                        data-roll="<%= item.student.rollno %>"
                                                        data-week="<%= item.week %>"
                                                        data-completed="<%= item.workCompleted %>"
                                                        data-challenges="<%= item.challengesFaced %>"
                                                        data-solutions="<%= item.challengesSolved %>"
                                                        data-skills="<%= item.skillsLearned %>"
                                                        data-goals="<%= item.goalsNextWeek %>"
                                                        data-status="<%= item.status %>"
                                                        data-feedback="<%= item.feedback || '' %>"
                                                        data-file="<%= item.file || '' %>"
                                                        data-allowedits="<%= item.allowTaskEdits %>"
                                                        style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.2); color: var(--primary); padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
                                                    Review
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div style="text-align: center; padding: 60px 20px; color: var(--text-muted);">
                            <p>No student submissions found for your department.</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Settings Tab -->
            <div id="tab-settings" class="tab-content">
                <div style="display: flex; flex-direction: column; gap: 16px; width: 100%;">
                    
                    <!-- 1. Faculty Profile -->
                    <div class="profile-card">
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            <h3 style="margin: 0;">Edit Faculty Profile</h3>
                        </div>

                        <form action="/faculty/updateprofile" method="POST" enctype="multipart/form-data">
                            <div style="display: flex; justify-content: center; margin-bottom: 24px;">
                                <div style="position: relative; width: 100px; height: 100px; border-radius: 50%; background: var(--glass); border: 2px dashed rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; overflow: hidden; cursor: pointer;" onclick="document.getElementById('facultyProfilePicUpload').click()">
                                    <% if (staff.profilePicture) { %>
                                        <img src="<%= staff.profilePicture.startsWith('http') ? staff.profilePicture : '/uploads/' + staff.profilePicture %>" style="width: 100%; height: 100%; object-fit: cover;" id="facultyProfilePreview" alt="Profile Picture">
                                    <% } else { %>
                                        <img src="" style="width: 100%; height: 100%; object-fit: cover; display: none;" id="facultyProfilePreview" alt="Profile Picture">
                                        <svg id="facultyProfileIcon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                                    <% } %>
                                    <div style="position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.6); font-size: 0.65rem; color: var(--text-main); text-align: center; padding: 4px 0; opacity: 0; transition: opacity 0.3s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0'">Change</div>
                                </div>
                                <input type="file" id="facultyProfilePicUpload" name="profilePicture" style="display: none;" accept="image/*" onchange="previewFacultyProfilePic(this)">
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                                <div class="form-group">
                                    <label>First Name</label>
                                    <input type="text" name="firstname" class="form-control" value="<%= staff.firstname %>" required>
                                </div>
                                <div class="form-group">
                                    <label>Last Name</label>
                                    <input type="text" name="lastname" class="form-control" value="<%= staff.lastname %>" required>
                                </div>
                                <div class="form-group">
                                    <label>Email Address</label>
                                    <input type="email" name="email" class="form-control" value="<%= staff.email %>" required>
                                </div>
                                <div class="form-group">
                                    <label>Designation</label>
                                    <input type="text" name="designation" class="form-control" value="<%= staff.designation %>" required>
                                </div>
                                <div class="form-group" style="grid-column: span 2;">
                                    <label>Department</label>
                                    <input type="text" name="department" class="form-control" value="<%= staff.department %>" required>
                                </div>
                            </div>
                            <button type="submit" class="auth-btn" style="width: 100%; margin-top: 16px;">Save Changes</button>
                        </form>
                    </div>

                    <!-- 2. Security Settings -->
                    <div class="profile-card">
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                            <h3 style="margin: 0;">Change Password</h3>
                        </div>
                        <form action="/faculty/changepassword" method="POST">
                            <div class="form-group">
                                <label>Current Password</label>
                                <input type="password" name="currentPassword" class="form-control" required>
                            </div>
                            <div class="form-group" style="margin-bottom: 24px;">
                                <label>New Password</label>
                                <input type="password" name="newPassword" class="form-control" required minlength="6">
                            </div>
                            <button type="submit" class="auth-btn" style="width: 100%;">Update Password</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Students Tab -->
            <div id="tab-students" class="tab-content">
                <div class="glass-card" style="margin-top: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                        <h3>Department Students</h3>
                    </div>
                    
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Roll No</th>
                                    <th>Course</th>
                                    <th>Internship Company</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (locals.allStudents && locals.allStudents.length > 0) { %>
                                    <% locals.allStudents.forEach(student => { %>
                                        <tr>
                                            <td>
                                                <div style="display: flex; align-items: center; gap: 10px;">
                                                    <div style="width: 32px; height: 32px; border-radius: 50%; overflow: hidden; background: var(--glass-border);">
                                                        <% if (student.profilePicture) { %>
                                                            <img src="<%= student.profilePicture.startsWith('http') ? student.profilePicture : '/uploads/' + student.profilePicture %>" style="width: 100%; height: 100%; object-fit: cover;">
                                                        <% } else { %>
                                                            <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-weight: bold; background: var(--primary); color: white; font-size: 0.8rem;"><%= student.firstname.charAt(0) %></div>
                                                        <% } %>
                                                    </div>
                                                    <div>
                                                        <div style="font-weight: 600; color: var(--text-main);"><%= student.firstname %> <%= student.lastname %></div>
                                                        <div style="font-size: 0.75rem; color: var(--text-muted);"><%= student.email %></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><%= student.rollno %></td>
                                            <td><%= student.course %></td>
                                            <td><%= student.internship && student.internship.companyName ? student.internship.companyName : 'Not Updated' %></td>
                                            <td>
                                                <button type="button" 
                                                    onclick="openStudentDetailModal(this)"
                                                    data-student='<%= JSON.stringify(student).replace(/'/g, "&#39;") %>'
                                                    style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.2); color: var(--primary); padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
                                                    View Details
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="5" style="text-align: center; color: var(--text-muted);">No students found in your department.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-link').forEach(el => el.classList.remove('active'));
            
            document.getElementById('tab-' + tabId).classList.add('active');
            event.currentTarget.classList.add('active');
            
            const titles = {
                'dashboard': 'Dashboard',
                'report': 'Reports Review',
                'students': 'Department Students',
                'settings': 'Settings'
            };
            document.getElementById('page-title').innerText = titles[tabId];
        }

        // Close dropdown when clicking outside
        window.onclick = function(event) {
            if (!event.target.matches('.notif-btn')) {
                var dropdowns = document.getElementsByClassName("notif-dropdown");
                for (var i = 0; i < dropdowns.length; i++) {
                    var openDropdown = dropdowns[i];
                    if (openDropdown.classList.contains('show')) {
                        openDropdown.classList.remove('show');
                    }
                }
            }
        }
    </script>
    
    <% if (typeof message !== 'undefined' && message) { %>
      <script>
        document.addEventListener("DOMContentLoaded", function() {
            const msg = "<%= message %>";
            const isError = msg.toLowerCase().includes('error') || msg.toLowerCase().includes('incorrect') || msg.toLowerCase().includes('fail');
            Toastify({
                text: msg,
                duration: 3000,
                gravity: "top",
                position: "right",
                style: {
                    background: isError ? "#ef4444" : "#10b981",
                    borderRadius: "8px",
                    boxShadow: "0 4px 12px rgba(0,0,0,0.15)"
                }
            }).showToast();
        });
      </script>
    <% } %>

  <!-- Review Weekly Summary Modal -->
  <div id="reviewModal" class="loader-overlay" style="z-index: 10000; align-items: center; justify-content: center;">
    <div style="background: var(--card-bg); padding: 32px; border-radius: 16px; border: 1px solid var(--glass-border); width: 90%; max-width: 750px; backdrop-filter: blur(20px); max-height: 90vh; overflow-y: auto;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; border-bottom: 1px solid var(--glass-border); padding-bottom: 16px;">
            <h3 style="margin: 0;">Review Submission</h3>
            <span id="reviewStatusBadge" class="status-badge"></span>
        </div>
        
        <!-- Student Info -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; background: rgba(255,255,255,0.02); padding: 16px; border-radius: 8px; border: 1px solid var(--glass-border);">
            <div>
                <label style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Student Name</label>
                <p id="reviewStudentName" style="margin: 4px 0 0; font-weight: 600;"></p>
            </div>
            <div>
                <label style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Roll Number</label>
                <p id="reviewStudentRoll" style="margin: 4px 0 0; font-weight: 600;"></p>
            </div>
        </div>

        <!-- Weekly Summary Details -->
        <h4 style="margin-top: 0; margin-bottom: 12px; color: var(--primary);">Weekly Summary (Week <span id="reviewWeekNum"></span>)</h4>
        <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 24px; background: rgba(255,255,255,0.02); padding: 16px; border-radius: 8px; border: 1px solid var(--glass-border);">
            <div>
                <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-main);">Work Completed:</label>
                <p id="reviewWorkCompleted" style="margin: 4px 0 0; font-size: 0.9rem; line-height: 1.4; color: var(--text-muted);"></p>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div>
                    <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-main);">Challenges Faced:</label>
                    <p id="reviewChallenges" style="margin: 4px 0 0; font-size: 0.9rem; line-height: 1.4; color: var(--text-muted);"></p>
                </div>
                <div>
                    <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-main);">How Solved:</label>
                    <p id="reviewSolutions" style="margin: 4px 0 0; font-size: 0.9rem; line-height: 1.4; color: var(--text-muted);"></p>
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div>
                    <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-main);">Skills Learned:</label>
                    <p id="reviewSkills" style="margin: 4px 0 0; font-size: 0.9rem; color: var(--text-muted);"></p>
                </div>
                <div>
                    <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-main);">Goals for Next Week:</label>
                    <p id="reviewGoals" style="margin: 4px 0 0; font-size: 0.9rem; line-height: 1.4; color: var(--text-muted);"></p>
                </div>
            </div>
            <div id="reviewFileContainer" style="display: none; margin-top: 8px;">
                <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-main);">Summary Attached File:</label>
                <p style="margin: 4px 0 0;"><a id="reviewFileLink" href="#" target="_blank" style="color: var(--accent); text-decoration: none; font-size: 0.85rem; font-weight: 600;">View Attachment</a></p>
            </div>
        </div>

        <!-- Collapsible Daily Task Logs Section -->
        <div style="margin-bottom: 24px;">
            <button onclick="toggleReviewTasks()" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: rgba(99, 102, 241, 0.05); border: 1px solid rgba(99, 102, 241, 0.15); padding: 12px 16px; border-radius: 8px; color: var(--primary); cursor: pointer; font-weight: 600; font-size: 0.9rem;">
                <span>Show/Hide Daily Task Logs (<span id="reviewTaskCount">0</span>)</span>
                <span id="reviewTaskArrow">▼</span>
            </button>
            <div id="reviewTasksContainer" style="display: none; margin-top: 12px; max-height: 250px; overflow-y: auto; border: 1px solid var(--glass-border); border-radius: 8px; background: rgba(0,0,0,0.1);">
                <table class="data-table" style="margin: 0; width: 100%;">
                    <thead>
                        <tr>
                            <th>Date & Title</th>
                            <th>Description</th>
                            <th>Hours</th>
                            <th>Status</th>
                            <th>Links</th>
                        </tr>
                    </thead>
                    <tbody id="reviewTasksTableBody">
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Faculty Feedback & Action Form -->
        <form id="reviewActionForm" method="POST" style="margin: 0;">
            <div class="form-group">
                <label>Remarks / Feedback *</label>
                <textarea name="feedback" id="reviewFeedbackText" rows="3" class="form-control" style="resize: none;" placeholder="Provide remarks or details of requested changes..."></textarea>
            </div>
            
            <div id="allowEditsContainer" class="form-group" style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
                <input type="checkbox" name="allowTaskEdits" id="reviewAllowEdits" style="width: auto; margin: 0;">
                <label for="reviewAllowEdits" style="margin: 0; font-size: 0.85rem; font-weight: normal; cursor: pointer;">Allow student to edit daily tasks for this week</label>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end; align-items: center;">
                <button type="button" onclick="closeReviewModal()" style="padding: 10px 20px; background: transparent; color: var(--text-muted); border: none; cursor: pointer; font-size: 0.9rem;">Cancel</button>
                <div style="display: flex; gap: 12px;">
                    <button type="button" onclick="submitReviewAction('request-changes')" style="padding: 10px 20px; background: #eab308; color: #000; border: none; border-radius: 8px; cursor: pointer; font-size: 0.9rem; font-weight: 600;">Request Changes</button>
                    <button type="button" onclick="submitReviewAction('approve')" style="padding: 10px 20px; background: #10b981; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 0.9rem; font-weight: 600;">Approve</button>
                </div>
            </div>
        </form>
    </div>
  </div>

  <script>
    let currentSummaryId = null;

    function openReviewModal(btn) {
        currentSummaryId = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        const roll = btn.getAttribute('data-roll');
        const week = btn.getAttribute('data-week');
        const completed = btn.getAttribute('data-completed');
        const challenges = btn.getAttribute('data-challenges');
        const solutions = btn.getAttribute('data-solutions');
        const skills = btn.getAttribute('data-skills');
        const goals = btn.getAttribute('data-goals');
        const status = btn.getAttribute('data-status');
        const feedback = btn.getAttribute('data-feedback');
        const fileUrl = btn.getAttribute('data-file');
        const allowEdits = btn.getAttribute('data-allowedits') === 'true';

        document.getElementById('reviewStudentName').innerText = name;
        document.getElementById('reviewStudentRoll').innerText = roll;
        document.getElementById('reviewWeekNum').innerText = week;
        document.getElementById('reviewWorkCompleted').innerText = completed;
        document.getElementById('reviewChallenges').innerText = challenges;
        document.getElementById('reviewSolutions').innerText = solutions;
        document.getElementById('reviewSkills').innerText = skills;
        document.getElementById('reviewGoals').innerText = goals;
        document.getElementById('reviewFeedbackText').value = feedback;
        document.getElementById('reviewAllowEdits').checked = allowEdits;

        if (fileUrl) {
            document.getElementById('reviewFileContainer').style.display = 'block';
            document.getElementById('reviewFileLink').href = fileUrl;
        } else {
            document.getElementById('reviewFileContainer').style.display = 'none';
        }

        const badge = document.getElementById('reviewStatusBadge');
        badge.innerText = status;
        badge.className = 'status-badge status-' + status.toLowerCase().replace(' ', '-');

        // Populate tasks
        const tasksScript = document.getElementById('tasks-' + currentSummaryId);
        let tasks = [];
        if (tasksScript) {
            try {
                tasks = JSON.parse(tasksScript.textContent);
            } catch(e) {
                console.error(e);
            }
        }
        
        document.getElementById('reviewTaskCount').innerText = tasks.length;
        
        const tbody = document.getElementById('reviewTasksTableBody');
        tbody.innerHTML = '';
        if (tasks.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--text-muted);">No task logs submitted for this week.</td></tr>';
        } else {
            tasks.forEach(t => {
                const dateStr = new Date(t.date).toLocaleDateString();
                let linksHtml = '';
                if (t.evidenceFile) {
                    linksHtml += `<a href="${t.evidenceFile}" target="_blank" style="color:var(--accent);text-decoration:none;font-size:0.75rem;margin-right:8px;">Evidence</a>`;
                }
                if (t.gitLink) {
                    linksHtml += `<a href="${t.gitLink}" target="_blank" style="color:var(--primary);text-decoration:none;font-size:0.75rem;margin-right:8px;">GitHub</a>`;
                }
                if (t.demoLink) {
                    linksHtml += `<a href="${t.demoLink}" target="_blank" style="color:#10b981;text-decoration:none;font-size:0.75rem;">Demo</a>`;
                }
                if (!linksHtml) linksHtml = '<span style="color:var(--text-muted);font-size:0.75rem;">None</span>';

                tbody.innerHTML += `
                    <tr>
                        <td>
                            <div style="font-weight:600;font-size:0.85rem;">${t.title}</div>
                            <div style="font-size:0.75rem;color:var(--text-muted);">${dateStr}</div>
                        </td>
                        <td style="font-size:0.8rem;line-height:1.3;max-width:200px;">${t.description}</td>
                        <td style="font-size:0.8rem;">${t.hoursWorked} hrs</td>
                        <td>
                            <span class="status-badge status-${t.status.toLowerCase().replace(' ', '-')}">${t.status}</span>
                        </td>
                        <td>${linksHtml}</td>
                    </tr>
                `;
            });
        }

        // Reset tasks visibility to closed
        document.getElementById('reviewTasksContainer').style.display = 'none';
        document.getElementById('reviewTaskArrow').innerText = '▼';

        document.getElementById('reviewModal').classList.add('active');
    }

    function toggleReviewTasks() {
        const container = document.getElementById('reviewTasksContainer');
        const arrow = document.getElementById('reviewTaskArrow');
        if (container.style.display === 'none') {
            container.style.display = 'block';
            arrow.innerText = '▲';
        } else {
            container.style.display = 'none';
            arrow.innerText = '▼';
        }
    }

    function closeReviewModal() {
        document.getElementById('reviewModal').classList.remove('active');
    }

    function submitReviewAction(action) {
        const form = document.getElementById('reviewActionForm');
        const feedback = document.getElementById('reviewFeedbackText').value.trim();

        if (action === 'request-changes') {
            if (!feedback) {
                alert('Please enter remarks/feedback explaining the requested changes.');
                return;
            }
            form.action = '/faculty/request-changes/' + currentSummaryId;
        } else {
            form.action = '/faculty/approve/' + currentSummaryId;
        }
        
        // Disable buttons and show processing state
        const buttons = form.querySelectorAll('button');
        buttons.forEach(btn => {
            btn.disabled = true;
            btn.style.opacity = '0.7';
            btn.style.cursor = 'not-allowed';
            if (btn.innerText.includes('Approve') || btn.innerText.includes('Request')) {
                btn.innerText = 'Processing...';
            }
        });

        form.submit();
    }

    function filterTable() {
        const filter = document.getElementById('statusFilter').value;
        const rows = document.querySelectorAll('.log-row');
        let visibleCount = 0;
        
        rows.forEach(row => {
            if (filter === 'all' || row.dataset.status === filter) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });
        
        document.getElementById('totalCountDisplay').innerText = visibleCount + ' Total';
    }
  </script>

  <!-- Global Loader -->
  <div id="global-loader" class="loader-overlay">
    <div class="spinner"></div>
    <div class="loader-text">Processing...</div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const forms = document.querySelectorAll("form");
      const loader = document.getElementById("global-loader");
      
      forms.forEach(form => {
        form.addEventListener("submit", function() {
          if (form.checkValidity()) {
            loader.classList.add("active");
            const buttons = form.querySelectorAll("button[type='submit']");
            setTimeout(() => {
                buttons.forEach(btn => {
                    btn.disabled = true;
                    btn.innerText = 'Processing...';
                    btn.style.opacity = '0.7';
                    btn.style.cursor = 'not-allowed';
                });
            }, 0);
          }
        });
      });
    });
  </script>

  <!-- Student Detail Modal -->
  <div id="studentDetailModal" class="loader-overlay" style="z-index: 10000; align-items: center; justify-content: center;">
    <div class="no-scrollbar" style="background: var(--card-bg); padding: 32px; border-radius: 16px; border: 1px solid var(--glass-border); width: 90%; max-width: 750px; backdrop-filter: blur(20px); max-height: 90vh; overflow-y: auto; position: relative;">
        
        <button type="button" onclick="closeStudentDetailModal()" style="position: absolute; top: 20px; right: 20px; background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); width: 32px; height: 32px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center;">✕</button>

        <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid var(--glass-border);">
            <div id="sdProfilePic" style="width: 80px; height: 80px; border-radius: 50%; overflow: hidden; background: var(--glass-border); display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: bold; color: white;">
            </div>
            <div>
                <h2 id="sdName" style="margin: 0 0 4px 0; color: var(--text-main);">Student Name</h2>
                <p id="sdCourseDept" style="margin: 0; color: var(--text-muted); font-size: 0.9rem;">Course - Dept</p>
                <div style="display: flex; gap: 12px; margin-top: 8px;">
                    <span style="background: rgba(99, 102, 241, 0.1); color: var(--primary); padding: 4px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600;">Roll: <span id="sdRoll"></span></span>
                </div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <!-- Contact Info -->
            <div>
                <h4 style="color: var(--primary); margin-bottom: 12px; font-size: 0.9rem;">Contact Information</h4>
                <div style="background: rgba(255,255,255,0.02); padding: 16px; border-radius: 8px; border: 1px solid var(--glass-border);">
                    <p style="margin: 0 0 8px 0; font-size: 0.85rem;"><span style="color: var(--text-muted);">Email:</span> <span id="sdEmail" style="color: var(--text-main); float: right;"></span></p>
                    <p style="margin: 0; font-size: 0.85rem;"><span style="color: var(--text-muted);">Phone:</span> <span id="sdPhone" style="color: var(--text-main); float: right;"></span></p>
                </div>
            </div>

            <!-- Internship Basic Info -->
            <div>
                <h4 style="color: var(--primary); margin-bottom: 12px; font-size: 0.9rem;">Internship Details</h4>
                <div style="background: rgba(255,255,255,0.02); padding: 16px; border-radius: 8px; border: 1px solid var(--glass-border);">
                    <p style="margin: 0 0 8px 0; font-size: 0.85rem;"><span style="color: var(--text-muted);">Company:</span> <span id="sdCompany" style="color: var(--text-main); float: right; font-weight: 600;"></span></p>
                    <p style="margin: 0 0 8px 0; font-size: 0.85rem;"><span style="color: var(--text-muted);">Field:</span> <span id="sdField" style="color: var(--text-main); float: right;"></span></p>
                    <p style="margin: 0 0 8px 0; font-size: 0.85rem;"><span style="color: var(--text-muted);">Duration:</span> <span id="sdDuration" style="color: var(--text-main); float: right;"></span></p>
                    <p style="margin: 0; font-size: 0.85rem;"><span style="color: var(--text-muted);">Mode:</span> <span id="sdMode" style="color: var(--text-main); float: right;"></span></p>
                </div>
            </div>
        </div>

        <div style="margin-top: 24px;">
            <h4 style="color: var(--primary); margin-bottom: 12px; font-size: 0.9rem;">Additional Internship Info</h4>
            <div style="background: rgba(255,255,255,0.02); padding: 16px; border-radius: 8px; border: 1px solid var(--glass-border); display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <p style="margin: 0; font-size: 0.85rem;"><span style="color: var(--text-muted);">Paid/Unpaid:</span> <span id="sdPaid" style="color: var(--text-main); float: right;"></span></p>
                <p style="margin: 0; font-size: 0.85rem;"><span style="color: var(--text-muted);">Stipend:</span> <span id="sdStipend" style="color: var(--text-main); float: right;"></span></p>
                <div style="grid-column: span 2;">
                    <p style="margin: 0 0 4px 0; font-size: 0.85rem; color: var(--text-muted);">Mentor Details:</p>
                    <p id="sdMentor" style="margin: 0; font-size: 0.85rem; color: var(--text-main); background: rgba(0,0,0,0.2); padding: 8px; border-radius: 4px;"></p>
                </div>
                <div style="grid-column: span 2;">
                    <p style="margin: 0 0 4px 0; font-size: 0.85rem; color: var(--text-muted);">Company Contact Details:</p>
                    <p id="sdContact" style="margin: 0; font-size: 0.85rem; color: var(--text-main); background: rgba(0,0,0,0.2); padding: 8px; border-radius: 4px;"></p>
                </div>
            </div>
        </div>
        
        <div style="margin-top: 24px;">
            <h4 style="color: var(--primary); margin-bottom: 12px; font-size: 0.9rem;">Important Links</h4>
            <div style="display: flex; gap: 12px; flex-wrap: wrap;" id="sdLinks">
                <!-- Links appended dynamically -->
            </div>
        </div>
    </div>
  </div>

  <script>
    function previewFacultyProfilePic(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const preview = document.getElementById('facultyProfilePreview');
                const icon = document.getElementById('facultyProfileIcon');
                if(icon) icon.style.display = 'none';
                preview.src = e.target.result;
                preview.style.display = 'block';
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    function openStudentDetailModal(btn) {
        const student = JSON.parse(btn.getAttribute('data-student'));
        
        document.getElementById('sdName').innerText = (student.firstname || '') + ' ' + (student.lastname || '');
        document.getElementById('sdCourseDept').innerText = (student.course || 'N/A') + ' - ' + (student.department || 'N/A');
        document.getElementById('sdRoll').innerText = student.rollno || 'N/A';
        document.getElementById('sdEmail').innerText = student.email || 'N/A';
        document.getElementById('sdPhone').innerText = student.phone || 'N/A';
        
        const internship = student.internship || {};
        document.getElementById('sdCompany').innerText = internship.companyName || 'Not Updated';
        document.getElementById('sdField').innerText = internship.internshipField || 'N/A';
        document.getElementById('sdDuration').innerText = internship.duration || 'N/A';
        document.getElementById('sdMode').innerText = internship.mode || 'N/A';
        document.getElementById('sdPaid').innerText = internship.isPaid || 'N/A';
        document.getElementById('sdStipend').innerText = internship.stipend ? '₹' + internship.stipend : 'N/A';
        document.getElementById('sdMentor').innerText = internship.mentorDetails || 'Not Provided';
        document.getElementById('sdContact').innerText = internship.contactDetails || 'Not Provided';
        
        // Profile Pic
        const picDiv = document.getElementById('sdProfilePic');
        if (student.profilePicture) {
            const url = student.profilePicture.startsWith('http') ? student.profilePicture : '/uploads/' + student.profilePicture;
            picDiv.innerHTML = `<img src="${url}" style="width: 100%; height: 100%; object-fit: cover;">`;
            picDiv.style.background = 'transparent';
        } else {
            picDiv.innerHTML = student.firstname ? student.firstname.charAt(0).toUpperCase() : 'U';
            picDiv.style.background = 'var(--primary)';
        }
        
        // Links
        const linksDiv = document.getElementById('sdLinks');
        linksDiv.innerHTML = '';
        if (internship.offerLetter) {
            linksDiv.innerHTML += `<a href="${internship.offerLetter}" target="_blank" style="padding: 8px 16px; background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 6px; text-decoration: none; font-size: 0.85rem; font-weight: 600;">Offer Letter</a>`;
        }
        if (internship.gitLink) {
            linksDiv.innerHTML += `<a href="${internship.gitLink}" target="_blank" style="padding: 8px 16px; background: rgba(99, 102, 241, 0.1); color: var(--primary); border: 1px solid rgba(99, 102, 241, 0.2); border-radius: 6px; text-decoration: none; font-size: 0.85rem; font-weight: 600;">GitHub Link</a>`;
        }
        if (internship.driveLink) {
            linksDiv.innerHTML += `<a href="${internship.driveLink}" target="_blank" style="padding: 8px 16px; background: rgba(234, 179, 8, 0.1); color: #eab308; border: 1px solid rgba(234, 179, 8, 0.2); border-radius: 6px; text-decoration: none; font-size: 0.85rem; font-weight: 600;">Drive Link</a>`;
        }
        if (linksDiv.innerHTML === '') {
            linksDiv.innerHTML = '<span style="color: var(--text-muted); font-size: 0.85rem;">No links provided by student.</span>';
        }
        
        document.getElementById('studentDetailModal').classList.add('active');
    }
    
    function closeStudentDetailModal() {
        document.getElementById('studentDetailModal').classList.remove('active');
    }
  </script>
</body>
</html>
