<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <style>
    body {
      font-family: Arial;
      padding: 20px;
    }
    h1 {
      text-align: center;
    }
    .card-container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
    }
    .card {
      border: 1px solid #ddd;
      border-radius: 10px;
      padding: 20px;
      width: 250px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      background: white;
    }
    .card h3 {
      margin-top: 0;
    }
  </style>
</head>
<body>
  <h1><%= title %></h1>
  <div class="card-container">
    <% items.forEach(item => { %>
      <div class="card">
        <h3><%= item.title %></h3>
        <p><%= item.description %></p>
        <% if (item.duration) { %><p><strong>Duration:</strong> <%= item.duration %></p><% } %>
        <% if (item.location) { %><p><strong>Location:</strong> <%= item.location %></p><% } %>
      </div>
    <% }) %>
  </div>
</body>
</html>
