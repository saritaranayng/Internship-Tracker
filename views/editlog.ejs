<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Log | Skill Record</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">

    <div class="auth-card" style="max-width: 500px;">
        <form action="/student/editlog/<%= log._id %>" method="POST" enctype="multipart/form-data">
            <h2 style="font-size: 1.5rem; margin-bottom: 24px;">Edit Submission</h2>
            
            <div class="form-group">
                <label>Week Number</label>
                <input type="number" name="week" value="<%= log.week %>" class="form-control" required>
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea name="description" class="form-control" rows="6" required style="resize: none;"><%= log.description %></textarea>
            </div>

            <div class="form-group">
                <label>Current Attachment</label>
                <div style="padding: 12px; background: rgba(255,255,255,0.05); border-radius: 8px; font-size: 0.9rem;">
                    <% if (log.file) { %>
                        <a href="/uploads/<%= log.file %>" target="_blank" style="color: var(--accent); text-decoration: none;">View Existing File</a>
                    <% } else { %>
                        <span style="color: var(--text-muted);">No file uploaded.</span>
                    <% } %>
                </div>
            </div>

            <div class="form-group">
                <label>Replace File (Optional)</label>
                <input type="file" name="file" class="form-control">
            </div>

            <button type="submit" class="auth-btn">Save Changes</button>
            <a href="/student/dashboard" class="back-link">Cancel and Return</a>
        </form>
    </div>

</body>
</html>