<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Report - Skill Record</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body style="background: var(--bg-color); color: var(--text-color); font-family: 'Outfit', sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; padding: 20px;">
    
    <!-- Decorator blobs -->
    <div style="position: fixed; top: -10%; left: -10%; width: 50vw; height: 50vw; background: radial-gradient(circle, rgba(99,102,241,0.15) 0%, rgba(15,23,42,0) 70%); border-radius: 50%; pointer-events: none; z-index: -1;"></div>
    <div style="position: fixed; bottom: -10%; right: -10%; width: 50vw; height: 50vw; background: radial-gradient(circle, rgba(6,182,212,0.15) 0%, rgba(15,23,42,0) 70%); border-radius: 50%; pointer-events: none; z-index: -1;"></div>

    <div style="width: 100%; max-width: 600px; position: relative;">
        <a href="/student/dashboard" style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem; margin-bottom: 20px; display: inline-block;">&larr; Back to Dashboard</a>
        
        <div class="auth-card" id="detailCard" style="padding: 40px; position: relative;">
            <% if (log.status !== 'Approved') { %>
                <button onclick="toggleEditForm()" style="position: absolute; top: 32px; right: 32px; background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.2); color: var(--primary); width: 36px; height: 36px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center;" title="Edit Report">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                </button>
            <% } %>

            <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 8px; color: white;">Log Details - Week <%= log.week %></h2>
            <div style="margin-bottom: 24px;">
                <span class="status-badge status-<%= log.status.toLowerCase().replace(' ', '-') %>"><%= log.status %></span>
            </div>

            <div style="margin-bottom: 24px;">
                <h4 style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 8px; font-weight: 500;">Description</h4>
                <div style="background: rgba(0,0,0,0.2); padding: 16px; border-radius: 8px; color: white; line-height: 1.6; white-space: pre-wrap;"><%= log.description %></div>
            </div>

            <% if (log.feedback && log.feedback.trim() !== '') { %>
                <div style="margin-bottom: 24px;">
                    <h4 style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 8px; font-weight: 500;">Faculty Remarks</h4>
                    <% if (log.status === 'Approved') { %>
                        <div style="background: rgba(16, 185, 129, 0.1); padding: 16px; border-radius: 8px; color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); line-height: 1.6;"><%= log.feedback %></div>
                    <% } else { %>
                        <div style="background: rgba(239, 68, 68, 0.1); padding: 16px; border-radius: 8px; color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); line-height: 1.6;"><%= log.feedback %></div>
                    <% } %>
                </div>
            <% } %>

            <% if (log.file) { %>
                <div style="margin-top: 32px;">
                    <a href="<%= log.file.startsWith('http') ? log.file : '/uploads/' + log.file %>" target="_blank" style="display: inline-block; background: rgba(6, 182, 212, 0.1); color: var(--accent); padding: 12px 24px; border-radius: 8px; text-decoration: none; border: 1px solid rgba(6, 182, 212, 0.2); font-weight: 500;">View Attached Artifact</a>
                </div>
            <% } %>
        </div>

        <div class="auth-card" id="editFormCard" style="padding: 40px; display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <h2 style="font-size: 1.5rem; font-weight: 600; color: white; margin: 0;">Update Details</h2>
                <button onclick="toggleEditForm()" style="background: transparent; border: none; color: var(--text-muted); cursor: pointer;">Cancel</button>
            </div>
            
            <form action="/student/editlog/<%= log._id %>" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label>Week Number</label>
                    <input type="number" name="week" class="form-control" value="<%= log.week %>" required>
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea name="description" class="form-control" rows="6" style="resize: none;" required><%= log.description %></textarea>
                </div>
                <div class="form-group" style="margin-bottom: 32px;">
                    <label>Update File (Optional)</label>
                    <input type="file" name="file" class="form-control">
                </div>
                <button type="submit" class="auth-btn" style="width: 100%;">Re-Submit</button>
            </form>
        </div>
    </div>

    <!-- Global Loader -->
    <div id="global-loader" class="loader-overlay">
      <div class="spinner"></div>
      <div class="loader-text">Processing...</div>
    </div>

    <script>
        function toggleEditForm() {
            const detailCard = document.getElementById('detailCard');
            const editFormCard = document.getElementById('editFormCard');
            if (detailCard.style.display === 'none') {
                detailCard.style.display = 'block';
                editFormCard.style.display = 'none';
            } else {
                detailCard.style.display = 'none';
                editFormCard.style.display = 'block';
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            const forms = document.querySelectorAll("form");
            const loader = document.getElementById("global-loader");
            
            forms.forEach(form => {
                form.addEventListener("submit", function() {
                    if (form.checkValidity()) {
                        loader.classList.add("active");
                        const buttons = form.querySelectorAll("button[type='submit']");
                        setTimeout(() => {
                            buttons.forEach(btn => {
                                btn.disabled = true;
                                btn.innerText = 'Processing...';
                                btn.style.opacity = '0.7';
                                btn.style.cursor = 'not-allowed';
                            });
                        }, 0);
                    }
                });
            });
        });
    </script>
</body>
</html>
